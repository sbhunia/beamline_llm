#
# mostab_dac.mac
#
# This macro packages defines a macro motor for the Chess Digital       # Mostab
#
# To use these macros you need to define a serial device like this 
#
# SERIAL        DEVICE <>TYPE  <>BAUD          	   <>MODE
# 0  YES    /dev/ttyS0     <>    115200              cooked
#
# And a motor controller like this
#
# MOTORS  DEVICE  ADDR        <>MODE  NUM          <>TYPE
#    YES  mostab  0                     1     Macro Motor
#
# The ADDR field should the serial device ID from the serial screen. 
#
# You can then add motors on the motor screen with the proper device
# unit and channel.
#


# DEPENDENCY INFO
#   PROVIDES:
#   NEEDS:
#




#
# MACRO DEFINITIONS
#


def mostab_config(mne, type, p1, p2, p3) '{
  global mostab_addr
  

  if(type == "ctrl" && mne == "..") {
	mostab_addr = mostab_ADDR
  }
}'


def mostab_cmd(mne, key, p1, p2) '{
  	local reply
	local mostab_int
	local temp0
		
  	if(key == "position") {     #reads harware postion
		ser_par(mostab_ADDR, "flush")
		ser_put(mostab_ADDR, "pos")
		reply = (ser_get(mostab_ADDR)/6553.5)
		#printf("reply=%u\n",reply)	
		return(reply)
		} 
	
	
 

 	if(key == "start_one") {    #normal move, p1 is target postion
	 	temp0 = p1*6553.5
	 	mostab_int = int(temp0)	
	 	#printf("p1 =%u\n",p1)
	 	#printf("p2 =%u\n",p2)
	 	#printf("mostab_int =%u\n",mostab_int)
	 	ser_par(mostab_ADDR, "flush")
	 	ser_put(mostab_ADDR,sprintf("md%s", mostab_int))
	 	reply = ser_get(mostab_ADDR)
		return
 		}

  	if(key == "get_status") {	
		return(0)
  		}
}'



#end
