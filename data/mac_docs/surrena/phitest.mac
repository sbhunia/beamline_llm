def back_and_forth '{
    local high low i dwell

    if($1 != phi){
        p "invalid motor " $1
        exit
    }

    if($# == 2)
        dwell = $2
    else
        dwell = 60

    low = get_lim($1,-2)
    high = get_lim($1,2)

    p "***motor " motor_mne($1) " is moving back and forth. Use Ctrl C to exit!***"
    while(1){
        umvd $1 low
        p motor_mne($1) " is sleeping for " dwell " s"
        sleep(dwell)
        umvd $1 high
        p motor_mne($1) " is sleeping for " dwell " s"
        sleep(dwell)
    }
}'