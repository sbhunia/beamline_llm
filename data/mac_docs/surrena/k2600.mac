def k2600_id'{
    k2600_send("*IDN?")
    p k2600_get()
}'

def k2600_reset'{
    #k2600_send("*RST")
    k2600_send("reset()")
}'

def k_beep '{
    k2600_send("beeper.enable = beeper.ON")
    k2600_send("beeper.beep(3,1000)") #3s 1kHz
}'

def k2600_voff '{
    k2600_send("smua.source.output = smua.OUTPUT_OUTPUT_OFF")
}'

def k2600_measure_i() '{
    #k2600_send("smua.measure.count = 1")
    #k2600_send("smua.measure.i(smua.nvbuffer1)")
    #k2600_send("print(smua.nvbuffer1)")
    
    k2600_send("reading = smua.measure.i()")
    k2600_send("print(reading)")

    return k2600_get()
}'

def k2600_sweep '{
    if($# != 4){
        p "usage: k2600_sweep start_V end_V step_V dwell_s"
        exit
    }
    local cmd[] points start end delay step i dir 

    start = $1
    end = $2
    step = fabs($3)
    delay = $4
    

    points = fabs((end - start) / $3) + 1

    # sweep from k2600
    #cmd[i++] = "smua.trigger.source.action = smua.DISABLE"
    #cmd[i++] = sprintf("smua.trigger.source.linearv(%i,%i,%i)",start,end,points)
    #cmd[i++] = sprintf("smua.source.delay = %i",delay)
    #cmd[i++] = "smua.trigger.source.action = smua.ENABLE"
    
    
    #for (i in cmd){
    #    k2600_send(cmd[i])
    #}
 
    
    # manual loop sweep
    if (end > start)
        dir = 1
    else
        dir = -1

    while(start < end){
        k2600_von(start)
        sleep(delay)
        start += (step * dir)
    }
    k2600_von(end)
    

}'

def k2600_von(voltage) '{
    local cmd

    if(voltage < -5.1|| voltage > 5.1){
        p "invalid voltage " voltage
        exit
    }

    cmd[i++] = "smua.source.func = smua.OUTPUT_DCVOLTS"
    cmd[i++] = sprintf("smua.source.levelv = %f",voltage)
    #cmd[i++] = "smua.source.output = smua.OUTPUT_OUTPUT_ON"
    cmd[i++] = "smua.source.output = 1"
    
    for (i in cmd){
        k2600_send(cmd[i])
    }  
    KV_SET = voltage
}'

def k2600_voltage '{
    k2600_send("")
}'

def k2600_send(cmd) '{
    local msg

    sock_par(K2600_ADD,"flush")
    msg = sprintf("%s\n",cmd)

    sock_put(K2600_ADD,msg)
}'

def k2600_get() '{
    return sock_get(K2600_ADD)
    #return sock_get(K2600_ADD,"\r")
}'

