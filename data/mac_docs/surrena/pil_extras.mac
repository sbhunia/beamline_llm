def pil_fly_on '{
    eval("pil_settrig \"Mult. Trigger\"")
    sleep(1)
}'

def pil_fly_off '{
    eval("pil_settrig \"Internal\"")
    sleep(1)
}'

def _pil_fly '{
    pil_fly_on
    cdef("cleanup_always","pil_fly_cleanup;","pil_fly",0x10)
}'

def pil_fly_cleanup '{
    pil_fly_off
    cdef("","","pil_fly","delete")
}'

def pil_fly_auto_on '{
    cdef("user_flyscan_pre_run","_pil_fly;","pil_fly_auto",0x10)
    cdef("user_flyscan_post_run","pil_fly_cleanup;","pil_fly_auto",0x10)
}'

def pil_fly_auto_off '{
    cdef("","","pil_fly_auto","delete")
}'