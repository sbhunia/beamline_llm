# macro for CHESS ops tuesday inspection
# placeholders exist for custom _pre and _post hooks at the station

def tuesday '{
    tuesday_pre                         #pre macro hook for station

    unix("printf \'\033[8;24;80t\'")    #sizes window for prout
    sleep(.5)
    eval("we")                          #helps to align paper print
    sleep(.5)
    eval("prout we")                    #print motor positions
    sleep(.5)
    unix("printf \'\033[8;30;100t\'")   #make bigger for human use

    tuesday_post                        #post macro hook for station
}'        

def tuesday_pre ''
def tuesday_post ''

