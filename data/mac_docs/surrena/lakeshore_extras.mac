#bandaid macro to deal with range issue with lakeshore
#KMS

def lakeshore_range_high_on '{
    cdef("user_flyscan_pre_run","_lakeshore_range_high;","_lakeshore_range_",0x10)
}'

def lakeshore_range_high_off '{
    cdef("","","_lakeshore_range_","delete")
}'

def _lakeshore_range_high 'epics_put("LAKESHORE2:RANGE2","Range3/High")'
def _lakeshore_range_off 'epics_put("LAKESHORE2:RANGE2","Off")'