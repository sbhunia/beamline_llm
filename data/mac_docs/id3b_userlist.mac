global STATION_ID \
	   DAQ_PREFIX   \
     HEP_IGNORE_STATUS

STATION_ID = "id3b"
DAQ_PREFIX = "/nfs/chess/daq"
HEP_IGNORE_STATUS = 0

def hep_getstat() '{
    if (HEP_IGNORE_STATUS)
      return(1)
    else
      return(counter_par(sec, "get_bit", HEP_STAT))
}'

def chk_beam '
  if  (hep_getstat())
    break
  else {
    print "Beam loss detected -- set HEP_IGNORE_STATUS to 1 to ignore"
    do_sleep FILL_TIME
  }
'

