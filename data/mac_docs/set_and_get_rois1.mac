def getroi6 '
_prxmin=epics_get("PIL6:ROI1:MinX")
_prymin=epics_get("PIL6:ROI1:MinY")
_prxsize=epics_get("PIL6:ROI1:SizeX")
_prysize=epics_get("PIL6:ROI1:SizeY")

p "Xmin="_prxmin
p "Ymin="_prymin
p "Xsize="_prxsize
p "Ysize="_prysize

'

def setroi6 '
epics_put("PIL6:ROI1:MinX",$1)
epics_put("PIL6:ROI1:MinY",$2)
epics_put("PIL6:ROI1:SizeX",$3)
epics_put("PIL6:ROI1:SizeY",$4)

sleep(.1)
getroi6

'


