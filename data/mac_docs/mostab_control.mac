def mos_control '{
	
	##if($1>2){
		##printf("\n0= Feedback Off\n") 
		##printf("1= Feedback On\n")
		##printf("2= Feedback Autoset\n")
		##}

	local keygrab
	#input("mode?  ")
	keygrab = input("mode? ")

	if(keygrab == ""){
		printf("off	  turns feedback off\n")
		printf("on	  turns feedback on\n")
		printf("auto	  auto tunes the mostab\n")
		printf("error	  shows current PID Terms\n")
		printf("PID	  brings up PID Adjustment Menu on Mostab\n")
		printf("in?  Returns the current inhibit mode\n")
		printf("inh0  turns inhibit off\n")
		printf("inh1  sets inhibit to I0\n")
		printf("inh2  sets inhibit to CESR TTL\n")
		printf("inh3  sets inhibit to I0 and CESR TTL\n")
		printf("inh4  sets inhibit to I0 or CESR TTL\n")
		printf("inh5  turns inhibit override on for 30 secoonds\n\n")
		keygrab = input("mode? ")
		}

	if(keygrab == "off"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"m1") # Sends m1 "fb off" via serial to Mostab
		printf("Turning feedback off\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "on"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"m0") # Sends m0 "fb on" via serial to Mostab
		printf("Turning feedback on\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}
		
	if(keygrab == "auto"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mA") # Sends mA "fb on" via serial to Mostab
		ser_par(0,"flush") # clears serial line
		printf("\nAuto Tuning In Progress\n\n")
		sleep (6)
		get1=ser_get(0)
		get2=ser_get(0)
		get3=ser_get(0)
		get4=ser_get(0)
		get5=ser_get(0)
		get6=ser_get(0)
		printf("%s\r",get1)
		printf("%s\r",get2)
		printf("%s\r",get3)
		printf("%s\r",get4)
		printf("%s\r",get5)
		printf("%s\r",get6)
		get1=0
		get2=0
		get3=0
		get4=0
		get5=0
		get6=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "error"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"e") # Sends e  via serial to Mostab
		printf("Getting PID Loop numbers\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "PID"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"m3") # Sends m3  via serial to Mostab
		printf("Getting PID Menu\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "inh?"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI") # Sends mI  via serial to Mostab
		printf("Requsting Inhibit mode\n\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\n",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		printf("inh0  turns inhibit off\n")
		printf("inh1  sets inhibit to I0\n")
		printf("inh2  sets inhibit to CESR TTL\n")
		printf("inh3  sets inhibit to I0 and CESR TTL\n")
		printf("inh4  sets inhibit to I0 or CESR TTL\n")
		printf("inh5  turns inhibit override on for 30 secoonds\n\n")
		keygrab = input("mode? ")
		}

	if(keygrab == "inh0"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI0") # Sends mI0  via serial to Mostab
		printf("Setting Inhibit mode\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "inh1"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI1") # Sends mI1  via serial to Mostab
		printf("Setting Inhibit mode\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "inh2"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI2") # Sends mI2  via serial to Mostab
		printf("Setting Inhibit mode\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "inh3"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI3") # Sends mI3  via serial to Mostab
		printf("Setting Inhibit mode\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "inh4"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI4") # Sends mI4  via serial to Mostab
		printf("Setting Inhibit mode\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if(keygrab == "inh5"){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mI5") # Sends mI5  via serial to Mostab
		printf("Sending Overide\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%sOveride Active\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}


}'
