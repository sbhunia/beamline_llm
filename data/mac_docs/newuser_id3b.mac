# 
# newuser_id3b.mac : Originally newuser_macro_lms.mac : Louisa Smieska
#
# 1. newuserid: creates a new directory, USERID (intended to match the User Database File ID) 
#    in both DAQROOT /nfs/chess/daq/CYCLE/STATION/ and AUXROOT /nfs/chess/auxiliary/reduced_data/cycles/CYCLE/STATION.
# 2. Creates symbolic lines in AUXROOT/USERID to the corresponding folder in DAQ (one via DAQ, the other via RAW).
# 3. Creates subdirectories "analysis" and "setup" in AUXROOT/USERID
# 4. Ensures group write permission for members of chess3buser to both areas.
# 5. Changes the current SPEC directory to DAQROOT/USERID
#
# Addition,  1/22/23:
#  * Invoke scanlog_on with a SCANLOGFILE with name [USERID].slog in DAQROOT/USERID.
#

############################################################################


STATIONS["id1a3"] = "id1a3"
STATIONS["id2a"] = "id2a"
STATIONS["id2b"] = "id2b"
STATIONS["id3a"] = "id3a"
STATIONS["id3b"] = "id3b"
STATIONS["id4a"] = "id4a"
STATIONS["id4b"] = "id4b"
STATIONS["id7a"] = "id7a"
STATIONS["id7b1"] = "id7b1"
STATIONS["id7b2"] = "id7b2"
#STATIONS["x1"] = "x1"


global AUXROOT BTRID DAQID DAQROOT GROUP_ID RAWROOT 
global SAMPLEID SAMPLENAME SNAPSHOTID USERID USERNAME

CYCLE = "2023-1"

####################
def newuserid '{
    _newuserid("$1")
}'

def _newuserid(id) '{
    local in_station in_username in_btrid in_maia_project

	if (argc == 0) {
		default_id = USERID
    } else {
        default_id = id
	}
	### Try to get the station ID automatically
	if (STATION_ID == 0){
		local host
		host = HOSTNAME
		tempaddr["0"] = "id3b"
		split(host,tempaddr,".")
		STATION_ID = tempaddr["0"]
	}

    if (!(STATION_ID in STATIONS)) {
		print "Oops -- STATION_ID not set, and unable to determine from host. Options are: "
		print STATIONS
    } else {
		print "\nUsing STATION_ID = " STATION_ID
	}
	local flag, tempd, tempr

	CYCLE = getsval("Enter / confirm current cycle (format NNNN-N)", CYCLE)
	id = getsval("Enter BTR ID (format prefix-NNNN-A) from Database", default_id)

	if (id == 0) {
		print "Invalid id -- abort"
		exit
	} 

	DAQROOT = sprintf("/nfs/chess/daq/%s/%s", CYCLE, STATION_ID)
    AUXROOT = sprintf("/nfs/chess/auxiliary/reduced_data/cycles/%s/%s", CYCLE, STATION_ID)
	RAWROOT = sprintf("/nfs/chess/raw/%s/%s", CYCLE, STATION_ID)
	tempstr = substr(STATION_ID, 3)

    GROUP_ID = sprintf("chess%suser",tempstr) 
    if (USERID == id) {
		print "New ID identical to current one -- no action taken"
		exit
	}

    # set temporary path to new directory
	tempd = sprintf("%s/%s", DAQROOT, id)
    if (file_info(tempd, "-d")) {
        flag = yesno(sprintf("%s already exists. Are you sure?", tempd), 0)
        if (flag) {
            #ok, but only make the directories writeable
            unix(sprintf("find %s -type d -exec chmod 755 {} +", tempd))
			#p sprintf("flag")
        } else {
             print "Aborting newuserid..."
			 exit
        }
    } else {
    	# create the daq directory:
   		unix(sprintf("mkdir -p %s", tempd))
    	# create the aux directory:
    	tempd = sprintf("%s/%s", AUXROOT, id)
    	unix(sprintf("mkdir -p %s", tempd))

		#change group permissions for aux
    	unix(sprintf("chgrp -R %s %s", GROUP_ID, tempd))
    	unix(sprintf("chmod -R g+w %s", tempd))

		#add analysis and setup directories to aux
		tempd = sprintf("%s/%s/analysis",AUXROOT,id)
		unix(sprintf("mkdir -p %s",tempd))
		#change group permissions for analysis
    	unix(sprintf("chgrp -R %s %s", GROUP_ID, tempd))
    	unix(sprintf("chmod -R g+w %s", tempd))

		tempd = sprintf("%s/%s/setup",AUXROOT,id)
		unix(sprintf("mkdir -p %s",tempd))
		#change group permissions for setup
    	unix(sprintf("chgrp -R %s %s", GROUP_ID, tempd))
   	 	unix(sprintf("chmod -R g+w %s", tempd))

		#add shortcut to current daq to aux- link will not persist after current cycle
		tempd = sprintf("%s/%s", DAQROOT, id)
		tempr = sprintf("%s/%s", AUXROOT, id)
		unix(sprintf("ln -s %s %s/daq", tempd, tempr))
		
		#add shortcut to raw to aux- link will persist after cycle
		tempd = sprintf("%s/%s", RAWROOT, id)
		tempr = sprintf("%s/%s", AUXROOT, id)
		unix(sprintf("ln -s %s %s/raw", tempd, tempr))

    	#ok, we are really going to proceed
    	#its time to protect data in the old directory
    	#unix(sprintf("chmod -R ugo-w %s/%s", DAQROOT, USERID)) 
		#USERID is at this point either 0 or a previous group
	}

    USERID = id
    eval(sprintf("cd %s/%s", DAQROOT, USERID))
    # p sprintf("Basedirectory has been set to %s/%s", DAQROOT, USERID)
    # p sprintf("Current working directory is now %s/%s", DAQROOT, USERID)
    # input("Remember to change next file numbers for EPICS DAQ systems...")
    # newsample 

	# Set up scanlogger:
	scanlog_off
	SCANLOGFILE = sprintf("%s/%s/%s.slog", DAQROOT, USERID, USERID)
	scanlog_on SCANLOGFILE

}'

def newsample '{
	#_newsample("$1")
}'

def _newsample(name) '{
	local tempn, tempd
	if (name == 0) {
		name = getsval("\nSample ID (no path delimiters, please)", SAMPLENAME)
	}
	
	tempd = sprintf("%s/%s/%s", DAQROOT, USERID, name)
	tempn = sprintf("%s/spec.log", tempd, name)
	if (file_info(tempd, "-d")){
		#need to check if tempn is writeable
		# file_info is not reliable, reports nonwriteable files are writeable
		if (open(tempn)) {
			p sprintf("%s is write-protected. Choose another name.", tempn)
			_newsample()
			exit
		} else {
			#need to close again, just checking if it was writeable
			close(tempn)
		}
	}
	# create daq directory:
	unix(sprintf("mkdir -p %s", tempd))

	# create the analysis directory:
	# tempd = sprintf("%s/%s/%s", AUXROOT, USERID, name)
	#unix(sprintf("mkdir -p %s", tempd))
	# change group permissions for aux
	#unix(sprintf("chgrp -R %s %s", GROUP_ID, tempd))
	#unix(sprintf("chmod -R g+w %s", tempd))

	SAMPLENAME = name
	SAMPLEID = sprintf("%s/%s", USERID, SAMPLENAME)
	SNAPSHOTID = sprintf("%s/snapshots", SAMPLEID)
	unix(sprintf("mkdir -p %s/%s", DAQROOT, SNAPSHOTID))
	DAQID = SNAPSHOTID
	eval(sprintf("_newfile %s/%s/spec.log", DAQROOT, SAMPLEID))
}'

