# code to update the mono energy PV from the calcM function

def auto_energy_PV '{
	if (LAMBDA == 0) {
		eprint "LAMBDA is zero.  Please \"moveE\" or \"setE\"."
		exit
	}
        epics_put("ID4B_MON_KEV", sprintf("%.3f keV", hc_over_e/LAMBDA))
}'

cdef("", "", "_energy_PV_", "delete")
cdef("calcE_local", "auto_energy_PV; ", "_energy_PV_")
