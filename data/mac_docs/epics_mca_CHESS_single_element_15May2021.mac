#==============================================================================
#                  SPEC macros for MCA acquisition via EPICS
#==============================================================================
#
# Description: Macros to setup and control multiple epics MCAs, allow users to
#              save mca spectra and the configured MCA ROIS into spec file.
#
# Written by: Xuesong Jiao
#
# Modified by: Darren Dale
#
# User macros: setup_mca -> interface to configure multiple epics MCAs in spec.
#              setup_mca (no paramerter) -> interactive mode
#              setup_mca mnemonic name PV -> quiet mode
#
#              mcasmode -> turn on mca data collection and save spectra to
#                          device files
#
#              show_mca -> display the configured epics MCAs nicely.
#              mca_rois -> to automatically check the created ROIS in each MCA
#                          and display their parameters.
#              save_rois -> to turn on/off the feature of saving
#                           MCA_ROIS(defined in roi_pv[], and filled when
#                           mca_rois is called)
#              rm_mca -> remove one or all configured MCAs,also remove all rois
#                        related to that MCA
#              rm_roi -> remove one/all configured MCA ROIS.Can also rmove all
#                        rois related to one MCA by calling rm_roi mca_mne
#
#==============================================================================

#==============================================================================
# global variables
#==============================================================================

global MCA_NAME[] MCA_PV[] DXP_PV[] MCA_USES_DXP[] MCA_SMODE[]
global MCA_MONITOR_EFFICIENCY MCA_IOC[] MCA_SKIP DXP_FAST_DEAD_TIME[]
global MCA_ROI_NAME[] MCA_ROI_LCH[] MCA_ROI_HCH[] MCA_ROI_N[]

global MCA_TIMEOUT
MCA_TIMEOUT = 2

#==============================================================================
# user macros defined here
#==============================================================================

#------------------------------------------------------------------------------
# setup_mca-> configure epics MCAs and create global arrays for each MCA
#------------------------------------------------------------------------------

def setup_mca '{
    if ($# != 0) {
        eprint "setup_mca takes no arguments"
        exit
    }

    p "Current MCA Setup:\n"
    show_mca

    while(yesno("\nConfigure a new MCA?", "1")) {
        local foo mne A_name name pv dxp_pv smode ioc n_mca dxp_fdt

        ioc = getval("EPICS IOC:", "vortex2:")

        n_mca = 1
        for (i in MCA_IOC) {
            n_mca += 1
        }

        mne = getval("MCA mnemonic:", sprintf("vortex%d", n_mca))
        if (mne == "") {
            continue
        }
        name = getval("MCA name:", mne)
        pv = getval("EPICS MCA PV:", sprintf("%smca%d", ioc, n_mca))
        smode = yesno("Record full spectra for this MCA?", "1")
        dxp_pv = getval(\
            "EPICS DXP PV (if used):",\
            sprintf("%sdxp%d:", ioc, n_mca)\
            )
        dxp_fdt = getval("enter the fast dead time >=0", 1.0e-6)

        # defer populating these arrays until all input has been collected
        # in case user escapes and leaves an mca half configured
        MCA_IOC[mne] = ioc
        MCA_NAME[mne] = name
        MCA_PV[mne] = pv
        MCA_SMODE[mne] = smode
        MCA_USES_DXP[mne] = dxp_pv?1:0
        if (dxp_pv) {
            DXP_PV[mne] = dxp_pv
            DXP_FAST_DEAD_TIME[mne] = dxp_fdt
        }

        foo = epics_par(sprintf("%s.VAL",MCA_PV[mne]), "count")
        printf("Found MCA with %i channels\n", foo)
        foo = epics_get(sprintf("%s.NUSE", MCA_PV[mne]))
        printf("Reading %i channels of MCA\n", foo)
        A_name = sprintf("mcadat_%s", mne)
        array @A_name[2][foo]
        array_op("fill", @A_name[0], 1)
        EPICS_MCAS++
        printf("Created data array %s for MCA %s\n", A_name, mne)
    }

    # make sure MCA_MONITOR_EFFICIENCY is not 0:
    set_mca_monitor_efficiency MCA_MONITOR_EFFICIENCY

    p "New MCA Setup:"
    show_mca

    if (_aa_length(MCA_PV) > 0) {
        cdef("user_Fheader", "_mca_specfile_Fheader();", "epics_mca", 0x10)
        cdef("user_postscan_head", "_mca_set_env();", "epics_mca")
        cdef("user_precount", "_mca_startcount();", "epics_mca", 0x20)
        cdef("user_postcount", "_mca_stopcount();", "epics_mca", 0x20)
        cdef("user_getcounts", "_mca_getcounts();", "epics_mca", 0x10)
        cdef("user_scan_loop", "_mca_report_counts();", "epics_mca", 0x10)
        cdef("cleanup_always", "_mca_stopcount();", "epics_mca")
    }
}'

def set_mca_monitor_efficiency '{
    MCA_MONITOR_EFFICIENCY = $1
    while (MCA_MONITOR_EFFICIENCY <= 0) {
        MCA_MONITOR_EFFICIENCY = getval("enter monitor efficiency > 0", 1)
    }
}'

#------------------------------------------------------------------------------
# rm_mca-> i.e. rm_mca all( clear all configure MCAs)
#               rm_mca mca1( clear MCA with mnemonic name mca1)
#------------------------------------------------------------------------------

def rm_mca '{
    local i
    for (i in MCA_PV) {
        #rm_roi all
        A_name = sprintf("mcadat_%s",i)
        unglobal @A_name
        delete MCA_PV[i] MCA_NAME[i] DXP_PV[i] MCA_USES_DXP[i] MCA_SMODE[i]
        delete MCA_IOC[i] DXP_FAST_DEAD_TIME[i]
        printf("Deleted MCA %s and data array %s\n",i,A_name)
    }
    MCA_SKIP = 0

    cdef("", "", "epics_mca", "delete")
}'

#------------------------------------------------------------------------------
# show_mca-> display configured MCAs and their configuration
#------------------------------------------------------------------------------

def show_mca '{
    if (unset("MCA_PV")) {
        global MCA_NAME[] MCA_PV[] MCA_SMODE[]
    }
    if (_aa_length(MCA_PV) == 0) {
        print "No MCA defined."
    } else {
        local tch uch A_name i

        printf("\n%8.8s %15.15s %16.16s %10.10s %8.8s %15.15s %9.9s",\
               "Mne", "Name", "EPICS_PV", "Total_Chs", "Use_Chs", "Data_array",\
               "Spectra")

        for (i in MCA_PV) {
            tch = epics_par(sprintf("%s.VAL", MCA_PV[i]), "count")
            uch = epics_get(sprintf("%s.NUSE", MCA_PV[i]))
            A_name = sprintf("mcadat_%s", i)
            printf("\n%8.8s %15.15s %16.16s %10i %8i %15.15s %9.9s",\
                i, MCA_NAME[i], MCA_PV[i], tch, uch, A_name, \
                MCA_SMODE[i]?"enabled":"disabled")
        }
        printf("\n")
    }
}'

#------------------------------------------------------------------------------
# mcasmode->Set the scan mode for epics interface
#------------------------------------------------------------------------------

def mcasmode '{
    local i
    if ($# == 0) {
        for (i in MCA_NAME) {
            local msg
            msg = sprintf("Record spectra for mca: %s", MCA_NAME[i])
            MCA_SMODE[i] = yesno(msg, "0")
        }
    } else if (("$1" == 0) || ("$1" == 1)) {
        for (i in MCA_NAME) {
            MCA_SMODE[i] = $1
        }
    } else {
        if ((("$2" != 1) && ("$2" != 0)) || $# > 2) {
            eprint "usage: mcasmode [0/1/[%mne% 0/1]]"
            exit
        }
        if ($# < 2) {
            local msg
            msg = sprintf("Record spectra for mca: %s", MCA_NAME[$1])
            MCA_SMODE[i] = yesno(msg, "0")
        } else {
            MCA_SMODE["$1"] = $2
        }
    }
    #for (i in MCA_NAME) {
    #	if (MCA_SMODE[i]){
	#   epics_put(sprintf(\"%sCollectMode\",MCA_IOC[i]), "MCA spectra")
	#}	   
    #}

}'

#==============================================================================
# internal macros defined here
#==============================================================================

def _mca_startcount() '{
    local i ioc visited[]

    for (i in MCA_PV) {
        if (!(MCA_SMODE[i]))
           continue

        ioc = MCA_PV[i]
        if (!(ioc in visited)) {
            visited[ioc] = 1

            epics_put(sprintf(\"%s.PRTM\", ioc), 0)
            epics_put(sprintf(\"%s.PLTM\", ioc), 0)
            epics_put(sprintf(\"%s.ERST\", ioc), 1)
            while (!(epics_get(sprintf("%s.ACQG", ioc), "short"))) {
                sleep(0.001)
            }
        }
    }
}'

def _mca_stopcount() '{
    local i visited[] REPEAT_STOP REPEAT_CTR

    #sleep(.1)
    for(i in MCA_PV) {
        if (!(MCA_SMODE[i]))
           continue
        wait(2); sleep(.05)
        ioc = MCA_PV[i]
        if (!(ioc in visited)) {
            visited[ioc] = 1
			REPEAT_STOP = 1
			REPEAT_CTR = 0
			while(REPEAT_STOP) {
            	epics_put(sprintf(\"%s.STOP\", ioc), 1, 2)
				if (EPICS_ERR != 0){
					print "In stopcount: EPICS_ERR = " EPICS_ERR
					#print "EPICS_ERR_MSG = " EPICS_ERROR_MSG
					sleep(0.5)
					epics_par(sprintf(\"%s\", ioc), "refresh") 
					REPEAT_CTR++
				} else {
					REPEAT_STOP = 0
				}
			}
        }
    }
    # make sure each IOC has stopped acquiring
    for(i in MCA_PV) {
        if (!(MCA_SMODE[i]))
           continue

        ioc = MCA_PV[i]
        if (!(ioc in visited)) {
            visited[ioc] = 1
            while (epics_get(sprintf("%s.ACQG", ioc), "short")) {
                # give the IOC more time to populate the records
                sleep(0.001)
            }
        }
    }
}'

def _mca_getcounts() '{
    local i ioc visited[]

    # make sure each IOC has populated the records
    for(i in MCA_PV) {
        if (!(MCA_SMODE[i]))
           continue

        ioc = MCA_PV[i]
        if (!(ioc in visited)) {
            visited[ioc] = 1
            while (epics_get(sprintf("%s.RDNG", ioc), "short")) {
                 # give the IOC more time to populate the records
                 sleep(0.01)
             }
        }
    }

    for (i in MCA_PV) {
        if (!(MCA_SMODE[i]))
           continue

        local A_name

        if (MCA_SMODE[i]) {
            A_name = sprintf("mcadat_%s", i)
            if (COUNT_TIME) {
                @A_name[1] = epics_get(MCA_PV[i])
            } else {
                array_op("fill", @A_name[:][1], 0)
            }
        }
    }
}'

#----------------------------------------------------------------------
# Save Data for each point in the same spec file with the proper format
# need to move most print statements to mca_Fheader
#----------------------------------------------------------------------

def _mca_report_counts() '{
    local mne

    for(mne in MCA_PV) {
        if (!(MCA_SMODE[mne]))
           continue
        local device_file real live tlive icr icrt ocr dead rname i roi_cts[] fdt

        device_file = _mca_get_device_file(mne)
        on(device_file)
        offt

        printf("%d", NPTS)

        for (i=0; i<MCA_ROI_N[mne]; i++) {
            if (COUNT_TIME) {
                roi_cts[i] = epics_get(sprintf("%s.R%i", MCA_PV[mne], i))
                printf(" %g", roi_cts[i])
            } else {
                 printf(" 0")
            }
        }

        if (MCA_USES_DXP[mne]) {
            if (COUNT_TIME) {
                real = epics_get(sprintf("%sElapsedRealTime", DXP_PV[mne]))
                live = epics_get(sprintf("%sElapsedLiveTime", DXP_PV[mne]))
                tlive = epics_get(sprintf("%sElapsedTriggerLiveTime",DXP_PV[mne]))
                triggers = epics_get(sprintf("%sTriggers", DXP_PV[mne]))
                events = epics_get(sprintf("%sEvents", DXP_PV[mne]))
                icr = epics_get(sprintf("%sInputCountRate", DXP_PV[mne]))
                icrt = icr
                ocr = epics_get(sprintf("%sOutputCountRate", DXP_PV[mne]))
                fdt = DXP_FAST_DEAD_TIME[mne]
                # Newtons method: find root of icr = icrt*exp(-icrt*fdt)
                for (i=0; i<3; i++) {
                    icrt = icrt - (icrt-icr*exp(icrt*fdt))/(1-fdt*icrt)
                }
                dead = icrt? (100 * (1 - ocr/icrt)):0
                printf(\
                    " %g %g %g %g %g %g %g %g %g %g", triggers, icr, icrt, \
                    ocr, real, live, tlive, dead, S[MON], events\
                    )
            } else {
                printf(" 0 0 0 0 0 0 0 0")
            }
        } else {
            printf(" %g", S[MON])
        }

        printf("\n")

        printf("@%s ", mne)
        A_name = sprintf("mcadat_%s", mne)
        array_dump(@A_name[1], "%25C")

        close(device_file)
        ont

        if (SC_DATA_ACTIVE && COUNT_TIME) {
            _mca_client_report(\
                mne, A_name, triggers, events, real, live, tlive, icr, icrt, \
                ocr, dead, roi_cts\
                )
        }
    }
}'

def _mca_client_report(\
    mne, A_name, triggers, events, real, live, tlive, icr, icrt, ocr, dead, \
    roi_cts\
    ) '{
    if (MCA_SMODE[mne]) {
        client_set_data(sprintf("%s/counts", mne), @A_name[1])
    }
    if (MCA_USES_DXP[mne]) {
        client_set_data(sprintf("%s/icr", mne), icr)
        client_set_data(sprintf("%s/icrt", mne), icrt)
        client_set_data(sprintf("%s/ocr", mne), ocr)
    }
    client_set_data(sprintf("%s/real", mne), real)
    client_set_data(sprintf("%s/live", mne), live)
    client_set_data(sprintf("%s/tlive", mne), tlive)
    client_set_data(sprintf("%s/triggers", mne), triggers)
    client_set_data(sprintf("%s/events", mne), events)
    client_set_data(sprintf("%s/dead_time", mne), dead)
    client_set_data(sprintf("%s/%s", mne, cnt_name(MON)), S[MON])

    for (i in roi_cts) {
        rname = MCA_ROI_NAME[sprintf("%s.R%iNM", MCA_PV[mne], i)]
        client_set_data(sprintf("%s/%s", mne, rname), roi_cts[i])
    }
}'

#----------------------------------------------------------------------
# Format the Header for a specfile
#----------------------------------------------------------------------

def _mca_specfile_Fheader() '{
    local mne

    for (mne in MCA_NAME) {
        printf("#U Saving data for mca %s in %s.scan%03d.%s.mca\n", \
            mne, DATAFILE, SCAN_N, mne)
    }
    printf("#U monitor = %s\n", cnt_name(MON))
}'


def _mca_set_env() '{
    local uch device_file kwargs[] mne _oo _ss _qq

    for (i in MCA_ROI_NAME) {
        delete MCA_ROI_NAME[i]
    }
    for (i in MCA_ROI_LCH) {
        delete MCA_ROI_LCH[i]
    }
    for (i in MCA_ROI_HCH) {
        delete MCA_ROI_HCH[i]
    }
    for (i in MCA_ROI_N) {
        delete MCA_ROI_N[i]
    }
    MCA_SKIP = 0

    for (mne in MCA_PV) {
        local nchannels
	
        if (!(MCA_SMODE[mne]))
           continue

        device_file = _mca_get_device_file(mne)

        if (NPTS == 0) {
            constant EPOCH time()
            fprintf(device_file, "#F %s\n", device_file)
            fprintf(device_file, "#E %d\n", EPOCH)
            fprintf(device_file, "#D %s\n", date())
            fprintf(device_file, "#C %s  User= %s\n", TITLE, USER)
        }

        fprintf(device_file, "\n#S %d  %s\n#D %s\n", SCAN_N, HEADING, DATE)

        if (COUNT_TIME<0) {
            fprintf(device_file, "#M %g (%s)\n", -COUNT_TIME, cnt_name(MON))
        } else {
            fprintf(device_file, "#T %g (%s)\n", COUNT_TIME, cnt_name(sec))
        }
        fprintf(device_file, "#U monitor = %s\n", cnt_name(MON))
        fprintf(device_file, "#U monitor efficiency = %g\n", \
            MCA_MONITOR_EFFICIENCY? MCA_MONITOR_EFFICIENCY:1)
        fprintf(device_file, "#U DXP fast_dead_time = %g\n", DXP_FAST_DEAD_TIME[mne])
        fprintf(device_file, "#U dead_time format = %s\n", "percent")

        local i
        for(i=0; i<16; i++) {
            local rname rlch rhch

            rname = sprintf("%s.R%iNM", MCA_PV[mne], i)
            rname_v = epics_get(rname)
            rlch = sprintf("%s.R%iLO", MCA_PV[mne], i)
            rlch_v = epics_get(rlch)
            rhch = sprintf("%s.R%iHI", MCA_PV[mne], i)
            rhch_v = epics_get(rhch)
            if ((rname_v != "") && (rlch_v != -1)) {
                MCA_ROI_N[mne]++
                MCA_ROI_NAME[rname] = rname_v
                MCA_ROI_LCH[rlch] = rlch_v
                MCA_ROI_HCH[rhch] = rhch_v
                fprintf(\
                    device_file,\
                    "#U ROI %s = %d %d\n", rname_v, rlch_v, rhch_v\
                    )
                if (rname_v == "mcaskip") {
                    MCA_SKIP = sprintf("%s.R%i", MCA_PV[mne], i)
                }
            }
        }

        uch = epics_get(sprintf("%s.NUSE", MCA_PV[mne]))

        fprintf(device_file, "#U EPICS mca: %s(%s)\n", mne, MCA_PV[mne])
        if (MCA_SMODE[mne]) {
            _oo = epics_get(sprintf("%s.CALO", MCA_PV[mne]))
            _ss = epics_get(sprintf("%s.CALS", MCA_PV[mne]))
            _qq = epics_get(sprintf("%s.CALQ", MCA_PV[mne]))
            fprintf(device_file, sprintf("#@%s %25C\n", mne))
            fprintf(device_file, "#@CHANN %i 0 %i 1\n", uch, uch-1)
            fprintf(device_file, "#@CALIB %g %g %g \n", _oo, _ss, _qq)
        }
        nchannels = 1 + MCA_ROI_N[mne]
        if (MCA_USES_DXP[mne]) {
            nchannels += 9
        }
        fprintf(device_file, sprintf("#N %d\n", nchannels))
        fprintf(device_file, sprintf("#L i"))
        for (i=0; i<MCA_ROI_N[mne]; i++) {
            rname = MCA_ROI_NAME[sprintf("%s.R%iNM", MCA_PV[mne], i)]
            fprintf(device_file, "  %s", rname)
        }
        if (MCA_USES_DXP[mne]) {
            fprintf(device_file, sprintf("  triggers  icr  icrt  ocr"))
            fprintf(device_file, sprintf("  real  live  tlive  dead_time"))
        }
        fprintf(device_file, sprintf("  %s  events", cnt_name(MON)))

        fprintf(device_file, "\n")
        close(device_file)

        if (SC_DATA_ACTIVE) {
            _mca_client_set_env(mne, uch, _oo, _ss, _qq)
        }
    }
}'

def _mca_client_set_env(mne, uch, _oo, _ss, _qq) '{
    local i kwargs[]

    local array cal[3]
    cal[0] = _oo; cal[0] = _ss; cal[0] = _qq
    kwargs["calibration"] = python_repr(python_repr(cal))
    kwargs["monitor"] = python_repr(cnt_name(MON))
    kwargs["fast_dead_time"] = python_repr(DXP_FAST_DEAD_TIME[mne])
    client_set_scan_env(mne, "MultiChannelAnalyzer", kwargs)

    for (i in kwargs) delete kwargs[i]
    local array shape[1]
    shape[0] = SC_NPOINTS
    kwargs["shape"] = python_repr(shape)
    kwargs["dtype"] = python_repr("f")
    kwargs["efficiency"] = python_repr(MCA_MONITOR_EFFICIENCY? MCA_MONITOR_EFFICIENCY:1)
    id = sprintf("%s/%s", mne, cnt_name(MON))
    client_set_scan_env(id, "Signal", kwargs)

    for (i=0; i<MCA_ROI_N[mne]; i++) {
        for (i in kwargs) delete kwargs[i]
        local array shape[1]
        local array roi[2]
        shape[0] = SC_NPOINTS
        kwargs["shape"] = python_repr(shape)
        kwargs["dtype"] = python_repr("f")
        rname = sprintf("%s.R%iNM", MCA_PV[mne], i)
        roi[0] = epics_get(sprintf("%s.R%iLO", MCA_PV[mne], i))
        roi[1] = epics_get(sprintf("%s.R%iHI", MCA_PV[mne], i))
        id = sprintf("%s/%s", mne, MCA_ROI_NAME[rname])
        kwargs["roi"] = python_repr(roi)
        client_set_scan_env(id, "Signal", kwargs)
    }

    if (MCA_SMODE[mne]) {
        for (i in kwargs) delete kwargs[i]
        local array shape[2]
        shape[0] = SC_NPOINTS; shape[1] = uch
        kwargs["shape"] = python_repr(shape)
        kwargs["dtype"] = python_repr("f")
        id = sprintf("%s/counts", mne)
        client_set_scan_env(id, "Spectrum", kwargs)

        for (i in kwargs) delete kwargs[i]
        local array mca_channels[uch]
        array_op("fill", mca_channels, 1, 1)
        kwargs["data"] = python_repr(mca_channels)
        id = sprintf("%s/channels", mne)
        client_set_scan_env(id, "Dataset", kwargs)
    }

    if (MCA_USES_DXP[mne]) {
        local units[] type dset
        local array shape[1]
        shape[0] = SC_NPOINTS

        units["triggers"] = ""
        units["events"] = ""
        units["icr"] = "1/s"
        units["icrt"] = "1/s"
        units["ocr"] = "1/s"
        units["real"] = "s"
        units["live"] = "s"
        units["tlive"] = "s"
        units["dead_time"] = "percent"

        for (dset in units) {
            for (i in kwargs) delete kwargs[i]
            kwargs["shape"] = python_repr(shape)
            kwargs["dtype"] = python_repr("f")
            kwargs["units"] = python_repr(units[dset])
            if (dset == "dead_time") {
                type = "DeadTime"
                kwargs["dead_time_format"] = python_repr(units[dset])
            } else {
                type = "Dataset"
            }
            id = sprintf("%s/%s", mne, dset)
            client_set_scan_env(id, type, kwargs)
        }
    }
}'


def _mca_get_device_file(mne) '{
    if (!index(DATAFILE,"/") && file_info(DATA_DIR,"-d")) {
        return(sprintf("%s%s.scan%03i.%s.mca", DATA_DIR, DATAFILE, SCAN_N, mne))
    } else {
        return(sprintf("%s.scan%03i.%s.mca", DATAFILE, SCAN_N, mne))
    }
}'


#==============================================================================
# supporting functions
#==============================================================================

def _aa_length(aname) '{
    local field n
    if( !( (whatis("aname")>>16)&0x100 ) ) {
        print "Not an associative array."
        exit
    }
    for (field in aname) {
        n++
    }
    return n
}'

#==============================================================================
# skipmode!
#
# A macro counter is defined such that a channel called mcaskip will
# be reported in spec's scalar arrays. This way it can be used in conjunction
# with the skipmode macros.
#==============================================================================


def mcaskip_config(mne, cnt, unit, p1, chan) '{
    if (_aa_length(MCA_PV) == 0) {
        return ".error."
    }
}'

def mcaskip_cmd(mne, key, p1, p2 ,unit) '{
    if (key == "get_status") {
        return 0
    } else if (key == "counts") {
        if (MCA_SKIP != 0){
            return epics_get(MCA_SKIP)
        } else {
            return 0
        }
    }

}'
