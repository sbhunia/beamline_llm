#macro for pre flyscan hooks for pico
def pico_pre '{
    if ($1) {
        cdef("user_flyscan_pre_run", "pico_enable; mono_background_prog;", "flyescan", 0x10)
    } else {
        cdef("", "", "flyescan", "delete")
    }

}'

def picoflye'{
    local temp_regions temp_length_on[] temp_length_off[] temp_count[] temp_length_last[] pico_data temp_trigger_us

    if($# != 6){
        p "usage: picoflye regions frame_steps frames dwell_steps final_steps mcs_pulse_us"
        exit
    }
    else{
        temp_regions = $1    
        temp_length_on = $2
        temp_count = $3
        temp_length_off = $4
        temp_length_last = $5
        temp_trigger_us = $6
    }
    
    ser_put(PICO_GEN_ADDR,"<disable>")
    ser_put(PICO_GEN_ADDR,"<mode,2>")
    ser_put(PICO_GEN_ADDR,sprintf("<regions,%i>",temp_regions))
    ser_put(PICO_GEN_ADDR,"<input_high>")
    ser_put(PICO_GEN_ADDR,"<output_high>")
    ser_put(PICO_GEN_ADDR,"<debounce,1>")
    ser_put(PICO_GEN_ADDR,sprintf("<trigger,%i>",temp_trigger_us))

    #updates pico with pulse length array using string concatenation
    cmd = "<length"
    if(temp_regions == 1){
        cmd = cmd "," temp_length_on[0]
    }
    else{
        for(edit_i = 0; edit_i < temp_regions; edit_i++){
            cmd = cmd "," temp_length_on[edit_i]
        }
    }
    cmd = cmd ">"
    ser_put(PICO_GEN_ADDR,cmd)

    #updates pico with pulse length array using string concatenation
    cmd = "<dead"
    if(temp_regions == 1){
        cmd = cmd "," temp_length_off[0]
    }
    else{
        for(edit_i = 0; edit_i < temp_regions; edit_i++){
            cmd = cmd "," temp_length_off[edit_i]
        }
    }
    cmd = cmd ">"
    ser_put(PICO_GEN_ADDR,cmd)

    #updates pico with pulse count array using string concatenation
    cmd = "<count"
    if(temp_regions ==1){
        cmd = cmd "," temp_count[0]
    }
    else{
        for(edit_i = 0; edit_i < temp_regions; edit_i++){
            cmd = cmd "," temp_count[edit_i]
        }
    }
    cmd = cmd ">"
    ser_put(PICO_GEN_ADDR,cmd)

    #updates pico with final frame pulse count for mono flyscanning
    cmd = "<last"
    if(temp_regions ==1){
        cmd = cmd "," temp_length_last[0]
    }
    else{
        for(edit_i = 0; edit_i < temp_regions; edit_i++){
            cmd = cmd "," temp_length_last[edit_i]
        }
    }
    cmd = cmd ">"
    ser_put(PICO_GEN_ADDR,cmd)

    PICO_DEBUG ? _pico_print_basic(1) : 0    #debug print
    #ser_put(PICO_GEN_ADDR,"<enable>")
}'
