def mfb '{
	
	if($1>2){
		printf("\n0= Feedback Off\n") 
		printf("1= Feedback On\n")
		printf("2= Feedback Autoset\n")
		}


	if($1 == 0){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"m1") # Sends m1 "fb off" via serial to Mostab
		printf("Turning feedback off\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}

	if($1 == 1){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"m0") # Sends m0 "fb on" via serial to Mostab
		printf("Turning feedback on\n")
		ser_par(0,"flush") # clears serial line
		get1=ser_get(0)
		printf("%s\r",get1)
		get1=0
		ser_par(0,"flush") # clears serial line
		}
		
	if($1 == 2){
		ser_par(0,"flush") # clears serial line
		ser_put (0,"mA") # Sends mA "fb on" via serial to Mostab
		ser_par(0,"flush") # clears serial line
		printf("\nAuto Tuning In Progress\n\n")
		sleep (6)
		get1=ser_get(0)
		get2=ser_get(0)
		get3=ser_get(0)
		get4=ser_get(0)
		get5=ser_get(0)
		printf("%s\r",get1)
		printf("%s\r",get2)
		printf("%s\r",get3)
		printf("%s\r",get4)
		printf("%s\r",get5)
		get1=0
		get2=0
		get3=0
		get4=0
		get5=0
		ser_par(0,"flush") # clears serial line
		}


}'

def mos_test '{
    while($#){
        mfb 0
        sleep($1)
        mfb 1
        sleep($1)
    }
}'