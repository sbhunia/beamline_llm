### Macros to integrate the Lakeshore 336 controller with spec ###
### JRuff, 2015
### Updated to use with the cryocoolGL, 2020

T_LO_SP = 0
T_HI_SP = 505

epics_put("LAKESHORE1:DISABLE_0",0)
epics_put("LAKESHORE1:DISABLE_1",0)
epics_put("LAKESHORE1:DISABLE_2",0)
epics_put("LAKESHORE1:DISABLE_3",0)

def measuretemp '
TEMP_SP=epics_get("LAKESHORE1:SETP_S2")
TEMP_S=epics_get("LAKESHORE1:KRDG1")
DEGC_SP=TEMP_SP-273.15
DEGC_S=TEMP_S-273.15
DEGC_R=TEMP_R-273.15
'

def _settemp '
epics_put("LAKESHORE1:SETP_S2",TEMP_SP)
'

def showtemp '
measuretemp
printf("    Sample Setpoint = %gK  \n",TEMP_SP,DEGC_SP)
printf("        Sample Temp = %gK  \n",TEMP_S,DEGC_S)
'

def runninghelium '
epics_put("LAKESHORE1:SETP_S1",30.0)
epics_put("LAKESHORE1:SETP_S3",5.0)
'

def prepN2_low '
epics_put("LAKESHORE1:SETP_S1",87)
epics_put("LAKESHORE1:SETP_S3",85)
'

def prepN2_high '
epics_put("LAKESHORE1:SETP_S1",165)
epics_put("LAKESHORE1:SETP_S3",160)
'


def roomT '
epics_put("LAKESHORE1:SETP_S1",222)
epics_put("LAKESHORE1:SETP_S3",220)
'

def turn_off_compressor '
epics_put("LAKESHORE1:SETP_S1",300)
epics_put("LAKESHORE1:SETP_S3",300)
'

def prepN2_medium '
epics_put("LAKESHORE1:SETP_S1",130)
epics_put("LAKESHORE1:SETP_S3",110)
'


def ramp '
_myramprate=$1
epics_put("LAKESHORE1:RAMP_S2",_myramprate)
'

