#
#   macro for using serial comm with aalborg flowmeter at 4b
#   moxa settings: 9600baud 1 stop bit 8 data bits no parity, no flow
#

global BORG_ADD;    BORG_ADD = sprintf("%s:4011",MOXA_ADD)  #adjust fpr chosen moxa port
global FLOW_HI;     FLOW_HI = 15                            #user input high flow rate limit
global FLOW_LO;     FLOW_LO = 5                             #user input low flow rate limit

def flow_set '{
    if($1){
        if($1 > 15 || $1 <5){
            p "flow exceeds limts of " FLOW_LO " and " FLOW_HI
            exit
        }

        p "setting flow to " $1
        _flow_set($1,0)
    }
    else
        _flow_set(0,0)       
}'

def _flow_set(val,save) '{
    if(val)
        borg_send(sprintf("S,%.02f",val))
    else
        borg_send("S")      

    local set
    set = substr(borg_get(),3)              #removes "S:" msg prefix
    p "flow set point is " set
    flow_get

    if(save){
        if(yesno("save current set point as default value?",0) == 1){
            borg_send(sprintf("S,%.02f,S",set))
            local saved[] get
            get = substr(borg_get(),3)      #removes "S:" msg prefix
            if(!split(get,saved,","))
                exit                        #if saving has already occured, it will only return a <CR>
            if(saved[0] != set){
                p "saved set point of " saved[0] " does not match expected " set
                p "try again..."
            }
            if(saved[1] != "S\r\n"){#k2600_send("smua.measure.count = 1")
            if(mne == voltage){
                #k2600_send("smua.measure.v(smua.nvbuffer1)")
                return KV_SET
            }
            if(mne == current){
                return k2600_measure_i()
                #k2600_send("smua.measure.i(smua.nvbuffer1)")
            }
            #k2600_send("print(smua.nvbuffer1)")
            #return k2600_get()
                p "set point did not save!"
                p "try again..."
            }
        }
        else{
            p "flow not saved..."
        }
    }
}'

def flow_save '{
    _flow_set(0,1)
}'

def flow_get '{
    local flow
    flow = _flow_get()
    p "flow is currently " flow
}'

def _flow_get() '{
    borg_send("F")
    return borg_get()
}'

def borg_send(cmd) '{
    local msg

    sock_par(BORG_ADD,"flush")
    msg = sprintf("%s\r",cmd)

    sock_put(BORG_ADD,msg)
}'

def borg_get() '{
    return sock_get(BORG_ADD,"\r\n")
}'

"""
for macro counter
device          NUM    Type
aalborg_flow    1      Macro Counter
"""

def aalborg_flow_config() '{
}'
    
def aalborg_flow_cmd(mne,key) '{
    if(key == "counts"){
        return _flow_get()
    }
}'