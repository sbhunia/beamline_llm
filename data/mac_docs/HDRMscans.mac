def greven_nov_tdep_lsco '
#heating
for (loopT=130; loopT<=200; loopT=loopT+5){
  eval(sprintf("onextalscan %s 180",loopT))
}
'

def greven_nov_tdep_oneaxis '
#cooling usage greven_nov_tdep start_T end_T T_step sleep_sec

for (loopT=$1; loopT>$2; loopT=loopT+$3){
  eval(sprintf("onextalscan %s %s",loopT,$4))
}
'


