def sortmypathout '
_mysamplepath="raw6M/" DATAFILE "/"
#_mysample="sample12_11_22/"
_mysample="check_lineup/"
_rampre="/ramdisk/ramshaw-3435-a/"
'


def threextalscan '

sortmypathout

_myT="$1"

te $1
sleep($2)

pil_on

eval(sprintf("u mkdir %s",_mysamplepath))
eval(sprintf("u mkdir %s%s",_mysamplepath,_mysample))
eval(sprintf("u mkdir %s%s%s",_mysamplepath,_mysample,_myT))

sleep(5)

_pilrampath=_rampre _mysamplepath _mysample _myT
#_pilrampath=_mysamplepath _mysample _myT
eval(sprintf("pil_setdir %s/",_pilrampath))
#eval(sprintf("pil_setdir %s",_pilrampath))

pil_settrig "Mult. Trigger"


umv chi 90 th 0 phi 0
opens
sleep(1)
flyscan phi 0 365 3650 .1
sleep(1)
closes

umv chi 85 th 3 phi 0
opens
sleep(1)
flyscan phi 0 365 3650 .1
sleep(1)
closes

umv chi 80 th -3 phi 0
opens
sleep(1)
flyscan phi 0 365 3650 .1
sleep(1)
closes


'

