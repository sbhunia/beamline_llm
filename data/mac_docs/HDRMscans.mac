def orderparam '

for (loopT=55; loopT>51; loopT=loopT-2){
  eval(sprintf("twotdepscan %s 1",loopT))
}

threextalscan 50 1

for (loopT=49; loopT>21; loopT=loopT-2){
  eval(sprintf("twotdepscan %s 1",loopT))
}

threextalscan 20 1
'

def automateTempScans '
for (loopT=360; loopT<364; loopT=loopT+2){
  eval(sprintf("threextalscan %s 1",loopT))
}

for (loopT=364; loopT<368; loopT=loopT+1){
  eval(sprintf("threextalscan %s 1",loopT))
}

#for (loopT=368; loopT<400; loopT=loopT+2){
#  eval(sprintf("threextalscan %s 1",loopT))
#}
'

def heightcheck '

umvr samz -.5
measT = $1

for (ii=0;ii<11;ii++){
  eval(sprintf("onetdepscan %s 100",measT))
  umvr samz .1
}

umvr samz -.5
'

def orderparam2 '
 thresh = 2 
 measT = $1
 te measT
 
 done = 0
 while(!done) {
   measuretemp
   t_diff = TEMP_S - measT
   #t_diff = measT-TEMP_S
   p (t_diff)
   if (t_diff<thresh){
      done = 1
   }
   else {
      eval(sprintf("onetdepscan %s 200",measT))
   }
}
'

