def heightscan '

pil_settrig "Internal"
eval(sprintf("pil_setdir %s/tiffs/",_rampre))
opens
lup samz -.4 .4 80 .2
closes
'

def checkresonance '

pil_settrig "Internal"
eval(sprintf("pil_setdir %s/tiffs/",_rampre))
opens
Escan 11.2 11.24 40 2
closes
'


