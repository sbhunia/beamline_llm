def alignfine '
    opens
    lup chi -0.2 0.2 50 0.1
    umv chi CEN
    lup th -0.05 0.05 50 0.1
    umv th CEN
    lup tth -0.1 0.1 50 0.1
    umv tth CEN
    lup th -0.03 0.03 30 0.1
    umv th CEN
    lup tth -0.1 0.1 50 0.1
    umv tth CEN
    lup chi -0.2 0.2 50 0.1
    umv chi CEN
    closes
    wh
'
def align2 '
    opens
    lup chi -0.1 0.1 50 0.1
    umv chi CEN
    lup th -0.01 0.01 30 0.1
    umv th CEN
    lup tth -0.05 0.05 50 0.1
    umv tth CEN
    closes
    wh
'

def getlscan '
    wh
    opens
    lscan 17.8 18.2 400 0.5
    closes
    moveE 11.23
    matchUE 3
    ubr H K L
    opens
    lscan 17.8 18.2 400 0.5
    closes
    moveE 11.215
    matchUE 3
    ubr H K L

'

def getlscan2 '
    wh
    opens
    lscan 18.96 19.04 120 1
    closes
    moveE 11.20
    matchUE 3
    ubr H K L
    opens
    lscan 18.96 19.04 120 1
    closes
    moveE 11.215
    matchUE 3
    ubr H K L

'

def gettthscan '
    wh
    alignfine
    opens
    th2th -0.04 0.04 90 0.5
    closes
    alignfine
    opens
    th2th -0.04 0.04 90 0.5
    closes

'

def gettthscan2 '
    wh
    align2
    opens
    lup cryz -0.2 0.2 40 0.1
    umv cryz CEN
    align2
    opens
    th2th -0.04 0.04 80 0.5
    closes

'
