# multi_pilatus_v5.mac -- AW August 2020
#
#
# Notes / ToDos- version 5:
#	(DONE) need PIL_H5 flag and a way to  set it.
#	(FIXED) : explore funny skip  row behavior of flymesh 1  .2  .4 .2 1000 (which skips a row of images, though flyscan
#			 spec scan is  normal)
#			 compared to flymesh 5 1 2 1 400 -- which evidently works fine.  Bad behavior begins with times > 500 ms.
#		 	 Seems fixed by adding _pil_wait_idle to  beginning  of  _pil_acquire
#	(FIXED) : Look for  quirks when doing setup/unsetup  on individual detectors.
#   (DONE) : Test with a 3rd Pilatus.
#   (DONE) : IF PIL_H5, then  create subdirectories for Tiff and H5 files.
#   (DONE) : Send example H5s to Ted.
#
# Requires:
#	1. globals STATION_ID and DAQ_PREFIX to be a string matching that which appears in /nfs/chess/daq/
#	2. For Fly mode: 1) The global variable _stype should be set such that (_stype & scanType_Fly) == True
#   				        2) _fly_intervals set to the number of frames / line. (Note that SPEC native code uses _fly_intervals)
#	3. Wiring for different trigger modes:
#			Internal: None
#		    External Trigger: The (buffered) "arm/gate" output from the counter/timer board
#									is connected to the "Ext In" input on the pilatus, and the pilatus is
#									set to "Mult. Trigger" mode. For more than one Pilatus, all three  detectors
#									can trigger on the same signal. Alternatively, 1 or more detectors can be triggered
#									by a "main" detector, and its "Ext. Out" triggers the other detectors.
#			Flyscan mode: See "flyscan_v5.mac" or more recent version. In summary, the Pilati are triggered
#								   by the clock output from the USBCTR device.
#

#  Goals:
#	a. (DONE-v1) handles multiple pilati / pilaten
#	b. (DONE-v3) can handle some degree of variation in trigger modes (external, internal),
#	c. (DONE-v1) implement "nicer" interface command (no more epics_puts, etc).
#	d. (DONE-v1) by definition, "ct" issuances are NOT saved, in the same way that ct results are not stored to the data file. Eliminate this.
#	e. (DONE  - version 5) Ideally -- option to save to hdf5 format.
#	f. (TODO) should be more easily generalized to ANDOR detector(s), mcas, etc.
#	g. (DONE  - v5) will be compatible with SPEC's native (since last year) flyscan macros. This
#				 uses SPECs "_stype" variable to check whether scanType_FLy is  active.
#  i. (DONE) Can easily direct images to local Pilatus computer disk (for diagnostics).
#  j. (DONE): Add "pil_movie" command: usage "pil_movie N_images time" that prepares and initiates
#			   a multi-image acquisition. Intention is that this could *still* be done in a few
#			   different trigger modes, but typically for use where all the triggering is handled
#			   externally, by Mike Thompsons "lasgo" software. Internally, this mode foregoes
#			   per-point metadata.
#	k. (DONE): Add access to alignment mode  from command line. (usage: pil_video N time?)
#	l. (NOT PLANNED): Consider whether _pil_wait_acquire should be part of _pil_acquire or possible added
#			   when in any external trigger mode.
#
# With antecedants in "area_detector.mac", this code will be specialized to Pilatus detectors
# and their specific use of the EPICS area_detector package.
# This should eliminate some of the complexity of that macro set.
#
###########################################################################################
##################################### List of Functions ###################################
###########################################################################################
#
# pil_setup PREFIX [N] [path_arg] / pil_unsetup n1 [n2 ..] | all
#     pil_setup: if N is omitted, use N=0
#       e.g. pil_setup PIL5 (set up PIL5 as the 0th pilatus, and set directory to CWD on DAQ)
# pil_unsetup: Un-setup one or more detectors, explicitly designated by number of “all” for all.
#       e.g  pil_unsetup 0 1 (unsetup detectors 0 and 1)
#	     pil_unsetup all (unsetup all detectors and delete the associative array “PIL”)
#       e.g  pil_unsetup 0 1 (unsetup detectors 0 and 1)
# pil_setdir [n1 [n2 ..]]  [newpath]
# pil_settrig [n1 [n2 ...]] trigmode
#		Set trigger mode (within spec scans) for 1 or more detectors: "Internal", "Ext. Enable",
#		"Mult. Trigger", or "Ext. Trigger"
# pil_show:
#     Lists Pilati that are set up and whether they are active, etc. Values from PIL
# pil_prout:
#	  Lists detail (from EPICS PVs) for active detectors, including E-thresh.
# pil_on/off
#		set target path for one or more detectors that are already set up
#		if newpath is -1 or absent, use current directory, which MUST be on the DAQ
# pil_von/voff
#		sets all active detectors  to "Alignment"  mode and begins taking snapshots.
# pil_movie  Nimages  dwell
# 		Sets up and initiates a series of pilatus images by all detectors that are on. If
#		the trigger mode is "Internal", then the movie begins immediately. Otherwise the detector
#		will await one or more triggers (depending on mode)
# pil_im_get:
#     Usage: pil_im_get(n, pv_suffix [, "string"])
#	  		 (a standin for e.g. epics_get("PIL5:cam1:<pv_suffix>" [, "string"])
# pil_im_set:
#	  Usage: pil_im_set(n, pv_suffix, val)
#			 (a standin for e.g. epics_put("PIL5:cam1:<pv_suffix>", val)
# pil_get/set: Like pil_im_get/set but where  "cam1" is absent from the PV string:
#			 (a standin for e.g. epics_get("PIL5:<pv_suffix>" [, "string"])
# _pil_scan_head: A pilatus-specific commands to be hooked to “scan_head” in the standard scan
#		sequence. Determines whether Trigger Mode, scan dimensionality, and if flymode is active.
#		Note that the file path is set here, but filename string is set in _pil_precount, since
#		for 2D scans it must be reset for each row.
# _pil_precount: A hook for user_precount macro that determines when to set the filename and
#   	initiate acquisition.
# _pil_file_setpath, _pil_file_setname:
#		sets filename based on scan dimensionality (and possibly trigger mode)
#
###########################################################################################
###########################################################################################
###########################################################################################
#
# Comments / Questions:
#   1. Original code was insistent that ad_off return the detector to a prior state. But my experience
#      has been that this has caused more trouble than it has fixed, since the prior state was often
#      poorly defined. However: what *should* the action be on ad_off? What will happen
#      if the user hits "acquire" butten  on the GUI in this state? *Should* there be a default location
#      for random acquisitions?
#   2. Should commands loop through active detectors?
#   3. What should pil_on look like?
#      	   a. Should it take arguments?
#      b. Should it assign multiple hooks (one per detector)? Or just one (I think just one).
#   4. How to handle multiple detectors -- particularly with different modes? E.g. do we want SPEC to keep
#      track of the trigger mode within the PIL variable, so that the correct trigger mode can be called
#      inside of a loop within the scan_head hook?
#
# DONE: In fly mode, NPTS is the same as the row number.
#       Otherwise, the row number is NPTS / _n1
# DONE: For 2D scans, set filename and filenumber at the start of each row.
# NOTE: For 2D scans, the last number is the point number and should always be
#       incremented automatically in the EPICS Area Detector interface.
#
# TODO: Add explanation of globals, e.g. PIL_OVERHEAD
#
# pil_get_path global variables DAQ_PREFIX and STATION_ID (which matches the string appearing in CWD)
# to verify that the user is on  the DAQ

# convenience:
def load_pil 'udo woll/Git_Repos/multi-pilatus/multi_pilatus_v5.mac'

# Globals
global DAQ_PREFIX PIL_PATH_BASE
DAQ_PREFIX = "/nfs/chess/daq"
PIL_PATH_BASE = "/ramdisk"

global PIL_DEBUG
PIL_DEBUG = 0

global PIL_NO_DET  PIL_ECHO
PIL_NO_DET = 0
PIL_ECHO = 0

print "PIL_NO_DET = " PIL_NO_DET ",  PIL_ECHO = ", PIL_ECHO
print "issue \"PIL_ECHO = 0\" to  turn off echo of epics commands"

global PIL 				   \
	   PIL_CDEF_LABEL      \
	   PIL_OVERHEAD 	   \
	   PIL_POSTCOMM_WAIT  \
	   PIL_TRIGGER_MODES   \
	   PIL_SCAN_DIMS       \
	   PIL_FLYMODE 		   \
	   PIL_INT_TRIG		   \
	   PIL_H5

PIL_CDEF_LABEL = "_pil_mac_"
PIL_OVERHEAD = .01
PIL_POSTCOMM_WAIT = .05
PIL_TRIGGER_MODES = ["Internal":1, "Ext. Enable":1, "Ext. Trigger":1, "Mult. Trigger":1]

global PIL_ROW_OFFSET
PIL_ROW_OFFSET = 0

###########################################################################################
############################ Principle user-facing macros #################################
## pil_setup, pil_settrig, pil_setdir, pil_on, pil_off, pil_unsetup, pil_prout, pil_show ##
###########################################################################################

def pil_setup '{
	local usage_str test_read test_write prefix n currentpath newpath path

	usage_str = "Usage: pil_setup PV_Prefix [n] [newpath]\n" \
		"\t where n is the detector index from 0 to 9, and newpath is the\n" \
		"\t output path relative to the detector-computer, interpreted as\n" \
		"\t either relative to the current directory or, if led by a forward slash \"/\"\n" \
		"\t an absolute path."

  	if ( ($# < 1) || ($# > 3) )  {
		eprint usage_str
		exit
  	}

  	prefix = "$1"; n = 0; newpath = -1

	# The following both tests read and write to EPICS, AND tries to overcome a bug
	# wherein ThresholdEnergy_RBV is initially zero even when  ThresholdEnergy is nonzero.

	if (PIL_NO_DET) {
	   test_read = "1"; test_write = "1"
	} else {
	   test_read = epics_get(sprintf("%s:cam1:ThresholdEnergy", prefix))
	   test_write = epics_put(sprintf("%s:cam1:ThresholdEnergy", prefix), test_read)
	}

	if ((test_read == "") || (test_write == "")){
		eprint "Error connecting to " prefix ": Aborting pil_setup"
		exit
	}

	if ($# == 2) {
  		if (length("$2") == 1){
  	 		n  = int("$2")
  	 	} else {
  	 		newpath = "$2"
  	 	}
  	} else if ($# == 3) {
  		n = int("$2")
  		newpath = "$3"
  	}

	if ((n < 0) || (n > 9)) {
  		eprint "pil_setup: det # n = ", n, "must be an integer from 0 to 9"
  		exit
	}

	PIL["det_setup"][n] = n
	PIL["ndet"] = 0
	for (i in PIL["det_setup"])
		PIL["ndet"]++
  	PIL[n]["prefix"] = prefix
  	PIL[n]["raw"] = 0
	PIL[n]["image"] = "cam1"
	PIL[n]["trigger"] = "Internal"
	PIL[n]["status_pv"] = PIL[n]["prefix"] ":cam1:DetectorState_RBV"

	if (PIL[n]["path"] == 0)
		PIL[n]["path"] = -1

  	eval(sprintf("pil_setdir  %s %s", n , newpath))

  	if (PIL[n]["path"] == -1) {
  		eprint "pil_setup: Error determining correct path -- aborting"
  		eval(sprintf("pil_unsetup  %d",  n))
  		exit
  	}

	pil_im_set(n, "ArrayCallbacks", "Enable")
	pil_im_set(n, "WaitForPlugins",  "Yes")
	pil_set(n, "Stats1:EnableCallbacks", "Enable")
	pil_set(n, "ROI1:EnableCallbacks", "Enable")
	pil_set(n, "HDF1:EnableCallbacks", "Enable")
	pil_set(n, "HDF1:ArrayCallbacks", "Enable")

	PIL["ndet"] = 0
	for (i in PIL["det_setup"])
		PIL["ndet"]++

	pil_show
}'

# pil_settrig: Note that if want to handle multiple indices without quotes,
# we just need to split the  arguments and assume the last one is the trig mode.
def pil_settrig '{
	local currentpath path usage_str nsplit argv_array[] det_array[]

	usage_str = "Usage: pil_settrig [\"detecotr indices\"] trigmode \n"  \
				"\t sets one or more detectors to use trigger_mode. \n" \
				"\t trigmode is a string matching an allowed mode in PIL_TRIGGER_MODES.\n" \
				"\t If 1st optional argument is absent, then all detectors are set.\n" \
				"\t e.g. 1: pil_settrig \"Internal\" : sets all detectors to Internal mode.\n" \
				"\t e.g. 2: pil_settrig \"1 2\" \"Mult. Trigger\" : sets only detectors 1 and 2."

	if ($# == 0) {
		eprint usage_str
		exit
	} else {
		nsplit = split("$@", argv_array, "\a")
		if (nsplit == 1) {
			trigmode =  "$1"
			for (i in  PIL["det_setup"])
				det_array[i] = i
		} else {
			trigmode = argv_array[nsplit-1]
			for (i = 0; i < (nsplit - 1) ; i++)
				det_array[i] = argv_array[i]
		}
	}

	if (!(trigmode in PIL_TRIGGER_MODES)) {
		eprint "Error in pil_settrig: Requested trigger mode \"" trigmode "\" is not valid\n"
		eprint "t Allowed modes are defined in PIL_TRIGGER_MODES"
		exit
	}

	for  (i in det_array) {
		if (!(det_array[i] in PIL["det_setup"])) {
			print "pil_settrig: pilatus " i " not setup -- skip"
			continue
		}
		PIL[det_array[i]]["trigger"] = trigmode
	}
	pil_show
}'

# pil_setdir behaves like pil_settrig: e.g.:
#	1. can affect 1 or more or all detectors,
#   2. if no args: update all pilati to current directory, etc.
#   3. if 1 arg: if a detector number: set that detector only to the current path
#           	 if a path: set all pilaten to point to that path
#   4. if more than one arg: could be only detectors or a list of detectors followed by
# 	   a path specification

def pil_setdir '{
	local currentpath path usage_str i n ndet nsplit argv_array[] det_array[]

	usage_str = "Usage: pil_setdir [\"detector indices\"] [\"newpath\"] \n" \
		"\t set the output image path of pilatus n to newpath.\n" \
		"\t If present, arg2 is treated as an absolute path (if it includes a leading \"/\"), \n" \
		"\t or as a path relative to the current directory on the daq.\n" \
		"\t If not present or == -1, the path is set to match the current directory on daq.\n" \
		"\t If the requested directory is not detected nor can be created by the Pilatus,\n " \
		"\t the Pilatus path reverts to its previous value. \n" \
		"\t In all cases the full requested path is returned."

	#print "argc = " argc " arg1 = " arg1

	newpath = -1
	ndet = 0

	nsplit = split("$*", argv_array)
	for (i = 0; i < nsplit ; i++) {
		if (argv_array[i] in PIL["det_setup"]){
			det_array[ndet] = argv_array[i]
			ndet++
		} else {
			newpath = argv_array[i]
			break
		}
	}

	if (ndet == 0)
		for (i in  PIL["det_setup"])
			det_array[i] = i

	if (newpath == -1){
  		path = pil_get_path()
	}
  	else if (substr(newpath,1,1) == "/")
  		path = newpath
  	else
  		path = pil_get_path(newpath)

  	if (path == -1) {
  		eprint "Error: In pil_setdir: cannot determine path."
  		eprint "       If valid, current path will be retained"
  		exit
  	}

	for (i in det_array) {
		n = det_array[i]
 		currentpath = pil_im_get(n, "FilePath_RBV", "string")
		pil_im_set(n, "FilePath", path)
 		if (pil_im_get(n, "FilePathExists_RBV") == "No") {
# 			eprintf("\nPath %s fron pilatus %d does not exist!\n\n", path, n)
#			eprintf("Reverting to %s and aborting\n", currentpath)
#			pil_im_set(n, "FilePath", currentpath)
# 			exit
 		} else
 			PIL[n]["path"] = path
	}
	# pil_show

}'

#pil_on_usage_str = "Usage: pil_on [<list of detector indices from 0 to 9>]\n" \
#		"\t Examples:\n" \
#		"\t\t 1. pil_on (turn on all detectors)\n" \
#		"\t\t 2. pil_on 0 (turn on detector  0 (detector index from 0 to 9))\n" \
#		"\t\t 3. pil_on 0 2 (turn detectors 0 and 2)"

def pil_on '{
	# pil_on [list of detector indices from 0 to 9]
	# 	Enable one or more pilati to snap images during scan.
	# 	Active detectors are maintained as an associative array PIL["det_on"]

	local i j nsplit det_list det_array[]

	if ($# == 0) {
		for (i in PIL["det_setup"])
 			PIL["det_on"][i] = i
		}
	else {
		nsplit = split("$*", det_array)
		for (i in det_array)
			if (det_array[i] in PIL["det_setup"])
				PIL["det_on"][det_array[i]] = int(det_array[i])
	}

  # Set up SRS Delay Generator to repeat MCS_CLK0 pulses with 0.1 ms square pulses.
  # Note: this is not OK for the Xspress detectors, where the trigger also acts
  # gate.
  # sync_repeat

	PIL["n_on"] = 0
	for (i in PIL["det_on"])
		PIL["n_on"]++

	if (PIL["n_on"] > 0) {
		cdef("", "", PIL_CDEF_LABEL, "delete")
		cdef("user_postscan_head", "_pil_scan_head; ", PIL_CDEF_LABEL, 0x10)
    cdef("user_precount", "_pil_precount;",  PIL_CDEF_LABEL, 0x10)
		cdef("user_flyscan_pre_run", "_pil_precount;",  PIL_CDEF_LABEL, 0x10)
		# The following line goes alongside,  "WaitForPlugins==Yes" in pil_setup
		# And note: can interfere with "uct" and other functions that update
		# counters during a ct.
    # The following is nice for internal triggering; not so much for Mult. Trigger
		cdef("user_getcounts", "_pil_getcounts;", PIL_CDEF_LABEL, 0x10)
	}

	pil_show

}'

def _pil_getcounts '
  if (PIL_INT_TRIG){
    _pil_wait_idle
    getcounts
  }
'


def pil_off '{
	local i nsplit det_array

	if ($# == 0) {
		for (i in PIL["det_setup"])
			delete PIL["det_on"][i]
		PIL["n_on"] = 0
		}
	else {
		nsplit = split("$*", det_array)
		for (i in det_array)
			if (det_array[i] in PIL["det_on"])
				delete PIL["det_on"][det_array[i]]
		PIL["n_on"] = 0
		for (i in PIL["det_on"])
			PIL["n_on"]++
		}

	if (PIL["n_on"] == 0)
		cdef("", "", PIL_CDEF_LABEL, "delete")

	pil_show

}'

def pil_unsetup '
	# Usage: pil_unsetup 0: unsetup detector 0
	#		 pil_unsetup all: unsetup all detectors

	local i nsplit det_array

	if ($# == 0) {
		print "pil_unsetup usage string -- (takes 1 or more arguments)"
		exit
	} else if ("$1" == "all"){
		print "OK: unsetting up " PIL["ndet"] " Pilatus detector(s)"
		PIL["ndet"] = 0
	}  else {
		nsplit = split("$*", det_array)
		for (i in det_array)
			if (det_array[i]  in PIL["det_on"])
				delete PIL["det_on"][det_array[i]]
			if (det_array[i]  in PIL["det_setup"]) {
				delete PIL["det_setup"][det_array[i]]
				for (j in PIL[det_array[i]])
					delete  PIL[det_array[i]][j]
			}
		PIL["n_on"] = 0
		for (i in PIL["det_on"])
			PIL["n_on"]++
		PIL["ndet"] = 0
		for (i in PIL["det_setup"])
			PIL["ndet"]++
		}

	if (PIL["ndet"] == 0){
		cdef("", "", PIL_CDEF_LABEL, "delete")
		delete PIL
	}

	pil_show
'

def pil_prout '
	local i
	printf("%d detectors defined\n", PIL["ndet"])
	for (i in PIL["det_setup"]) {
		printf("%s:", PIL[i]["prefix"])
  		printf("\t File Path: %s\n", pil_im_get(i, "FilePath_RBV", "string"))
	   	printf("\t File Name: %s\n", pil_im_get(i, "FileName_RBV", "string"))
		printf("\t Trig Mode: %s\n", pil_im_get(i, "TriggerMode_RBV", "string"))
  		printf("\t Energy Threshold: %.1f\n", pil_im_get(i, "ThresholdEnergy_RBV", "float"))
  	}
'

def pil_show '
	local i
	printf("%d detectors defined\n", PIL["ndet"])
	for (i in PIL["det_setup"]) {
		offon = (i  in PIL["det_on"]) ? "ON" : "OFF"
		printf("Pilatus %d/%s is %3s; Mode:%14s; path:%s\n", i, PIL[i]["prefix"], offon, \
				PIL[i]["trigger"], PIL[i]["path"])
  	}
'

def pil_von '{
   local frame_time
	if ($# == 1) {
   	frame_time = $1
	} else if ($# == 0){
   	frame_time = 1
	} else {
		eprint "Usage: pil_von [dwell]"
		exit
		}
	for (i in PIL["det_on"]) {
		pil_im_set(i, "TriggerMode", "Alignment")
		pil_im_set(i, "AcquireTime", frame_time - PIL_OVERHEAD)
		pil_im_set(i, "AcquirePeriod", frame_time)
		pil_im_set(i, "Acquire", "Acquire")
		}

}'

def pil_voff '{
	for (i in PIL["det_on"]) {
		pil_im_set(i, "Acquire", "Done")
		pil_im_set(i, "TriggerMode", PIL[i]["trigger"])
		}
}'

# pil_movie foregos metadata -- e.g. so "tseries 1 1" that actually triggers a movie would  be OK
# but if we invoke "tseries" then we have a problem that  pil macros will take Nimages and Time
# parameters from tseries input.
# Approach 1: Forego usual scan header: set up movie, increment SCAN_N, and go
# Approach 2: Make a no-frills version inside flyscan macros (fly_movie?)
# Approach 3: hit the fly mode bit here, so that we can make use of them from here.

# August 16: The version of pil_movie below is extremely bare bones, but could be used
# with either internal or external triggering. E.g. precede with pil_settrig "Ext. Enable",
# followed by pil_movie,  and then a trigger going from an external piece of equipment
# to the pilatus (e.g. like the Thompson / Vandover experiment in Dec 2019).

def pil_movie  '{
	if ($# < 2) {
   		eprint "Usage: pil_movie Nimages Time"
   		exit
	}

	HEADING = "$0 " "$*"
	_nm = 0
	_ctime = $2
	_stype = scanType_Fly
	_fly_intervals = $1

	scan_head

	#print "PIL_FLYMODE = " PIL_FLYMODE ", PIL_SCAN_DIMS = " PIL_SCAN_DIMS

	comment "Starting movie with %d frames, %.2f seconds / frame" "_fly_intervals, _ctime"

	NPTS = 0
	count_em 1

}'

##########################################
############ Utility macros  #############
##########################################

def _pil_wait_acquire '{
	for (i in PIL["det_on"])
  		while(pil_im_get(i, "DetectorState_RBV") != "Acquire")
  			sleep(.05)
}'

def _pil_halt '{
	for (i in PIL["det_on"]) {
		pil_im_set(i, "Acquire", "Done")
		if  (PIL_H5)
			pil_set(i, "HDF1:Capture", "Done")
	}
}'

def _pil_wait_idle '{
	local det_stat n det_ready cap_ready
	if (PIL_DEBUG)
		print "_pil_wait_idle: begin"
  for (i in PIL["det_on"]) {
  		n = 0
  		while(1) {
  			det_stat = pil_im_get(i, "DetectorState_RBV")
				det_ready = (det_stat == "Idle") || (det_stat == "Aborted") || (det_stat == "Error")
				if (PIL_H5){
					cap_ready = (pil_get(i, "HDF1:WriteFile_RBV") == "Done")
					det_ready = det_ready && cap_ready
				}
				if (det_ready || PIL_NO_DET )
				  break
			  if (n > 300) {
				  print "Pilatus " i "-" PIL[i]["prefix"] " not idle -- may need intervention"
				  break
			}
			sleep(0.05)
			n++
  		}
  	}
}'



# _pil_scan_head
# 1. (done) Determine & create an assoc. array of active detectors.
# 2. (done) Do _pil_file_set, _pil_halt, _pil_wait_idle (which loop through active detectors)
# 3. (done) Set waitcount (currently empty) and cleanup cdefs
# 4. (done) Set up Trigger mode, frame time, and NumImages.
# 5. (done) flyscan_v4.mac sets _stype, which  is used here to find out where to get the
#           number of frames.
#			(done) Remaining ToDo: handle internal triggering.
# 6. DONE: have to deal with different precount demands, and possibly different filename convention
#
# There three variables: scan dimension (1 or 2), triggering (internal/external), and scan mode (fly / no fly)
# If internal triggering:
#    n_images = 1, filename and acquire command done in precount. filenumber reset row each for 2D scans
# For external trigger (not fly):
#    n_images = _n1 or FLY_FASTMODE_INTERVALS (to be  replaced by _fly_intervals (I think)  to stay compatible),
#    filename sent at start of scan or each  row (to reset row number if  necessary), acquire sent at start of scan
#    or row
# For fly scanning:
#    n_image = FLY_FASTMODE_INTERVALS / _fly_intervals, filename sent at  start of scan or row acquire sent at the
#    start of scan or row

def _pil_scan_head '{
	local n_images

	_pil_halt
  	_pil_wait_idle

  	cdef("cleanup_once", "_pil_cleanup;", PIL_CDEF_LABEL)

 	_pil_file_setpath

	# NOTE: Sept 2020: learned that _pil_scan_head should happen BEFORE fly_postscan_head to
	# avoid missing the first trigger.
	if  (PIL_DEBUG)
		prdef  user_postscan_head

	PIL_INT_TRIG = 0
	for (i in PIL["det_on"])
	    if (PIL[i]["trigger"] == "Internal") {
	       #pil_settrig  "Internal"
	       PIL_INT_TRIG = 1
	       break
	    }
	if (_stype  & scanType_MeshScan)
		PIL_SCAN_DIMS = 2
	else
		PIL_SCAN_DIMS = 1
	if (_stype & scanType_Fly) {
		PIL_FLYMODE = 1
		n_images = _fly_intervals + 1
	} else {
	    PIL_FLYMODE = 0
		if (PIL_INT_TRIG)
		   n_images = 1
		else
		   n_images = _n1
	}

  # time per point calc for native spec fly scan
  if (PIL_FLYMODE)
    _dwell  =  _ctime/_fly_intervals
  else
    _dwell  = _ctime

	for (i in PIL["det_on"]) {
		pil_im_set(i, "TriggerMode", PIL[i]["trigger"])
	  	pil_im_set(i, "ImageMode", "Single")
	  	pil_im_set(i, "AcquireTime", _dwell-PIL_OVERHEAD)
	  	pil_im_set(i, "AcquirePeriod", _dwell) #+ PIL_OVERHEAD)
	  	pil_im_set(i, "NumImages", n_images)
		if (PIL_H5) {
			pil_set(i, "HDF1:NumExtraDims", 0)
			pil_set(i, "HDF1:ExtraDimSizeN", n_images)
			pil_set(i, "HDF1:FileWriteMode", "Capture")
			pil_set(i, "HDF1:AutoSave", "Yes")
		}
	}

  	pil_show
}'

def _pil_precount '{
	# Now extra given this occurs in user_getcounts
	# _pil_wait_idle
  if (PIL_DEBUG)
    print "In  _pil_precount"
	if (PIL_INT_TRIG) {
		if ((NPTS % _n1) == 0){
			_pil_file_setname
			_pil_capture
			}
		_pil_acquire
	} else
    	if ( (PIL_FLYMODE) || ((NPTS % _n1) == 0) ) {
       		_pil_file_setname
					_pil_capture
      		_pil_acquire
    	}
}'

def _pil_capture '
	if (PIL_H5){
    for (i in PIL["det_on"])
		  pil_set(i, "HDF1:Capture", "Capture")
	}
'

def _pil_acquire '{
  for (i in PIL["det_on"]) {
			if (PIL_DEBUG)
				print "In _pil_acquire: pil " i " DetectorState is " pil_im_get(i, "DetectorState_RBV")
	  	pil_im_set(i, "Acquire", "Acquire")
      _pil_wait_acquire
	}
}'


def _pil_cleanup '{
	_pil_halt
}'

#
# Helper macros
#


# _pil_file_setpath: if saving  h5 files, then  create subdirs for both Tiff and H5 images.
# Note too: here we use the fact that the FilePath PV in  cam1 creates directories as  needed
# but the  HDF1  plugin does not. Hence the extra FilePath calls  in the PIL_H5 branch.
def _pil_file_setpath '{
	local num, file, scanpath
	num = split(DATAFILE, file, "/")
	scanpath = sprintf("%s/%s_%03d", PIL[i]["path"], file[num - 1], SCAN_N)

  for(i in PIL["det_on"]) {
  	pil_im_set(i, "FileTemplate", "%s%s_%03d.tiff")
  	pil_im_set(i, "FileNumber", 0)
	  pil_im_set(i, "AutoIncrement", "Yes")
  	pil_im_set(i, "FilePath", scanpath)
	if (PIL_H5) {
		pil_im_set(i, "FilePath", sprintf("%s/H5", scanpath) )
		pil_set(i, "HDF1:FilePath", sprintf("%s/H5", scanpath))
		pil_im_set(i, "FilePath", sprintf("%s/Tiff", scanpath))
		pil_set(i, "HDF1:FileTemplate", "%s%s.h5")
		}
	}
}'

def _pil_file_setname '{
  local num, file, n_slow

  num = split(DATAFILE, file, "/")

  if (PIL_SCAN_DIMS == 1)
  	for(i in PIL["det_on"]){
  		pil_im_set(i, "FileName", sprintf("%s_%s_%03d", file[num - 1], \
  				   PIL[i]["prefix"], SCAN_N))
		if (PIL_H5)
			pil_set(i, "HDF1:FileName", sprintf("%s_%s_%03d", file[num - 1], \
  				   PIL[i]["prefix"], SCAN_N))
	}
  else if (PIL_SCAN_DIMS == 2) {
    if  (PIL_FLYMODE) {
      for(i in PIL["det_on"])
        pil_im_set(i, "FileNumber", 0)
      n_slow = int(NPTS / _n0)   # TODO: This may  not be correct  for built in fly mode...
    } else {
      if (NPTS % _n1 == 0)
        for(i in PIL["det_on"])
          pil_im_set(i, "FileNumber", 0)
      n_slow = int(NPTS / _n1)
    }
    # print "Inside _pil_file_setname: n_slow = " n_slow
    for(i in PIL["det_on"]) {
  		pil_im_set(i, "FileName", sprintf("%s_%s_%03d_%03d", file[num - 1], \
  				   PIL[i]["prefix"], SCAN_N, n_slow + PIL_ROW_OFFSET))
		if (PIL_H5)
			pil_set(i, "HDF1:FileName", sprintf("%s_%s_%03d_%03d", file[num - 1], \
  				   PIL[i]["prefix"], SCAN_N, n_slow + PIL_ROW_OFFSET))
	  }
  }

}'

def pil_get_path() '{
	local on_daq relative_path_index

	if (!((argc == 0) || (argc == 1))) {
		eprint "pil_get_path usage:"
		eprint "\t 1) pil_get_path() : set path to current directory on " PIL_PATH_BASE
		eprint "\t 2) pil_get_path(\"<relative_path>\"): append relative_path to current directory on the daq"
		exit
	}

	on_daq = (index(CWD, PIL_PATH_BASE) == 1)
	relative_path_index = index(CWD, STATION_ID)+length(STATION_ID)+1
	if ( (on_daq == 0) || (relative_path_index == 0) ) {
		eprint "Error: pil_get_path failed to locate current directory or find STATION_ID " \
				  STATION_ID " on DAQ"
		eprint "STATION_ID should be set in userlist.mac or station.mac, e.g."
		return (-1)
	}
	if (argc == 0)
		return(sprintf("%s/%s",PIL_PATH_BASE, substr(CWD,relative_path_index)))
	else
		return(sprintf("%s/%s/%s",PIL_PATH_BASE, substr(CWD,relative_path_index), arg1))
}'

# Usage: pil_im_get(n, pv_prefix [,"string"])
def pil_get(n, pv_suffix) '{
    if (PIL[n]["prefix"] == 0) {
       eprint "Error in pil_get: Pilatus " n " not set up\n"
       exit
       }
   if  (argc > 2){
   	  if (PIL_NO_DET || PIL_ECHO)
   		 printf("pil_get: Issuing return(epics_get(sprintf(\"%s:%s\" , \"%s\"))\n", \
   						PIL[n]["prefix"], pv_suffix, arg3)
   	  if (!(PIL_NO_DET))
			  return(epics_get(sprintf("%s:%s", PIL[n]["prefix"], pv_suffix), arg3))
  	} else {
   	   if (PIL_NO_DET || PIL_ECHO)
   		  	printf("pil_get: Issuing return(epics_get(sprintf(\"%s:%s\"))\n", PIL[n]["prefix"], pv_suffix)
	   	 if (!(PIL_NO_DET))
		  		return(epics_get(sprintf("%s:%s", PIL[n]["prefix"], pv_suffix)))
	}
}'

def pil_set(n, pv_suffix, val) '{
    if (PIL[n]["prefix"] == 0) {
       eprint "Error in pil_set: Pilatus " n " not set up\n"
       exit
       }
   if  (PIL_NO_DET || PIL_ECHO)
   		printf("pil_set: Issuing epics_put(sprintf(\"%s:%s\", %s))\n", PIL[n]["prefix"], pv_suffix, val)
   if (!(PIL_NO_DET)) {
		  epics_put(sprintf("%s:%s", PIL[n]["prefix"], pv_suffix), val)
     sleep(PIL_POSTCOMM_WAIT)
	 }
}'

def pil_im_get(n, pv_suffix) '{
	# Usage: pil_im_get(n, pv_prefix [,"string"])
    if ((PIL[n]["prefix"] == 0) || (PIL[n]["image"] == 0)) {
       eprint "Error in pil_im_get: Pilatus " n " not set up\n"
       exit
       }
   if  (argc > 2){
   	  if (PIL_NO_DET || PIL_ECHO)
   		   printf("pil_im_get: Issuing return(epics_get(sprintf(\"%s:%s:%s\" , \"%s\"))\n", \
   					PIL[n]["prefix"], PIL[n]["image"], pv_suffix, arg3)
	     if (!(PIL_NO_DET))
   		    return(epics_get(sprintf("%s:%s:%s", PIL[n]["prefix"], PIL[n]["image"], pv_suffix), arg3))
   } else {
   	if (PIL_NO_DET || PIL_ECHO)
   		printf("pil_im_get: Issuing return(epics_get(sprintf(\"%s:%s:%s\"))\n", PIL[n]["prefix"], PIL[n]["image"], pv_suffix)
    if (!(PIL_NO_DET))
		  return(epics_get(sprintf("%s:%s:%s", PIL[n]["prefix"], PIL[n]["image"], pv_suffix)))
	}
}'

def pil_im_set(n, pv_suffix, val) '{
    if ((PIL[n]["prefix"] == 0) || (PIL[n]["image"] == 0)) {
       eprint "Error in pil_im_set: Pilatus " n " not set up\n"
       exit
       }
    if  (PIL_NO_DET || PIL_ECHO)
   		printf("pil_im_set: Issuing epics_put(sprintf(\"%s:%s:%s\", %s))\n", PIL[n]["prefix"], PIL[n]["image"], pv_suffix, val)
	  if (!(PIL_NO_DET)){
   		epics_put(sprintf("%s:%s:%s", PIL[n]["prefix"], PIL[n]["image"], pv_suffix), val)
      sleep(PIL_POSTCOMM_WAIT)
	 }
}'

