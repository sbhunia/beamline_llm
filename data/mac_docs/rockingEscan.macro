def rockingEscan '
if ($# != 3) {
	eprint "Usage:  rockingEscan start finish intervals"
	exit
}
counters cesr ic1
plotselect ic1
_METAFILE2="Escan_" DATAFILE "_" SCAN_N+1 ".peak"
_STEPU=($2-$1)/$3
for (_myE=$1;_myE<=$2;_myE=_myE+_STEPU){
moveE _myE
lup mond -.01 .01 40 .2
umv mond pl_xMAX
syncmon
ct -1e5
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,A[monu],A[mond],A[und_cl],S[cesr],S[ic1],S[ic2]); off(_METAFILE2)
}
eval(sprintf("fclose %s", _METAFILE2))
'

