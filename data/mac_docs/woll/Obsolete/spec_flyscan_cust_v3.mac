# In the long term, this file should ONLY contain customizations to fly_chk_beam and, possibly, to the setup of the delay generator (which, as of 11/11/20, is contained in multi_pilatus_v5.mac). 

# For now this is also a test bed for checking beam before and within a sweep. 

FLY_THRESH_CTR = cnt_num("ic2")
FLY_THRESH_MCSCTR = cnt_num("ic2_2")
FLY_THRESH = 80000
FLY_IGNORE_THRESH = 1
FLY_CHECK_MCSCTR = 0

# Flip the  following global to 1 if a motorless flyscan should use external channel advance.
# This is the plan for running with the Thompson/vanDover Group. 
#FLY_nomotor_ext = 0

FLY_TRIG_HIGH = 3
FLY_TRIG_RISING = 5
FLY_TRIG_NONE = 1

def fly_trigup 'counter_par(sec, "set_bit", FLY_TRIGCHAN)'
def fly_trigdown 'counter_par(sec, "clr_bit", FLY_TRIGCHAN)'

FLY_TRIGCHAN=0

def fly_trig_first '{
	if ((FLY_trigger_mode == FLY_TRIG_NONE) || (FLY_trigger_mode == FLY_TRIG_HIGH) || \
		(FLY_trigger_mode == FLY_TRIG_RISING)){
		fly_trigup; sleep(.001); fly_trigdown
	}

}'

def fly_cust_def '
	fly_cust_undef
	cdef("user_flyscan_pre_run", "fly_wait_for_beam;", "__fly_cust__", 0x10)
	cdef("user_flyscan_trigger", "fly_trig_first;", "__fly_cust__")
'

def fly_cust_undef  'cdef("","", "__fly_cust__", "delete")'

def fly_cust_show '
	printf("flyscan customiziations (spec_flyscan_cust_v3.mac):\n")
	printf("\t FLY_THRESH_CTR : S[%d]  == %s\n", FLY_THRESH_CTR, cnt_mne(FLY_THRESH_CTR))
	printf("\t FLY_THRESH_MCSCTR : S[%d] == %s\n", FLY_THRESH_MCSCTR, cnt_mne(FLY_THRESH_MCSCTR))
	printf("\t FLY_THRESH ==  %d Hz\n", FLY_THRESH)
	printf("\t FLY_IGNORE_THRESH == %d\n", FLY_IGNORE_THRESH)
	printf("\t FLY_CHECK_MCSCTR == %d\n", FLY_CHECK_MCSCTR)
'

def fly_cust_set '
	printf("flyscan customiziations (spec_flyscan_cust_v3.mac):\n")
	printf("\t FLY_THRESH_CTR : S[%d]  == %s\n", FLY_THRESH_CTR, cnt_mne(FLY_THRESH_CTR))
	FLY_THRESH_CTR  = getval("\tFLY_THRESH_CTR?", FLY_THRESH_CTR)
	printf("\t OK, FLY_THRESH_CTR == %s\n", cnt_mne(FLY_THRESH_CTR))
	printf("\t FLY_THRESH_MCSCTR : S[%d] == %s\n", FLY_THRESH_MCSCTR, cnt_mne(FLY_THRESH_MCSCTR))
	FLY_THRESH_MCSCTR  = getval("\tFLY_THRESH_MCSCTR?", FLY_THRESH_MCSCTR)
	printf("\t OK, FLY_THRESH_MCSCTR == %s\n", cnt_mne(FLY_THRESH_MCSCTR))
	FLY_THRESH  = getval("\tFLY_THRESH?", FLY_THRESH)
	FLY_IGNORE_THRESH = getval("\tFLY_IGNORE_THRESH?", FLY_IGNORE_THRESH)
	FLY_CHECK_MCSCTR = getval("\tFLY_CHECK_MCSCTR?", FLY_CHECK_MCSCTR)
	FLY_nomotor_ext = getval("\tUse external channel advance for motorless flyscan?", FLY_nomotor_ext)
'

# NEXT TODO: FIX MCS_DATA BELOW --> SCAN_D
#            DETERMINE DWELL TIME PER MCS CHANNEL -- (_fly_intervals)/_ctime?

def _fly_check_thresh() '{
	if (FLY_IGNORE_THRESH)
		return(1)
	tcount(0.1); waitcount; getcounts;
	#p S
	#printf("\nS[%d] = %s ==  %d\n\n", FLY_THRESH_CTR, cnt_mne(FLY_THRESH_CTR),  S[FLY_THRESH_CTR])
	if (S[FLY_THRESH_CTR] / 0.1  > FLY_THRESH)
		return(1)
	else
		return(0)
}'

def fly_wait_for_beam '{
	local _fly_wait_time  _fly_t0 _fly_delay 
    _fly_t0 = time()
    _fly_delay = 0
	#printf("In _fly_wait_for_beam\n")
     while (!(_fly_check_thresh())) {
       _fly_delay++
       if (_fly_delay%5 == 1)
           print "Beam down -- checking once/5 seconds..(set FLY_IGNORE_THRESH to proceed anyay)"
       sleep(5)
     }
     if (_fly_delay>0){
	   _fly_wait_time =  (time()-_fly_t0)/60.0
       comment "Beam Interruption: Resumed after %.2f minutes" "_fly_wait_time"
	}
	
}'

def fly_chk_beam '
    if (_fly_check_thresh()){
			 _fly_dwell = _ctime/_fly_intervals
			 #print "fly_dwell = " _fly_dwell
			 FLY_BEAM_OK =  1
			 #p _fly_SCAN_D_cols 
			 if  (FLY_CHECK_MCSCTR) {
			 	for (i = 0; i < (_fly_intervals+1); i++) {
					#printf(" Val  = %d\n",SCAN_D[i][_fly_SCAN_D_cols[FLY_THRESH_MCSCTR]]) 
				 	if (SCAN_D[i][_fly_SCAN_D_cols[FLY_THRESH_MCSCTR]] / _fly_dwell < FLY_THRESH) {
						print "In fly_chk_beam: beam interruption detected"
			 		  FLY_BEAM_OK = 0
					  break
					}
			 	}
			 }
			 # print "in fly_chk_beam: Yes there is beam -- breaking"
			 if (FLY_BEAM_OK)
        		break
	  }
      print "In fly_chk_beam: beam loss detected: repeat line"
'



