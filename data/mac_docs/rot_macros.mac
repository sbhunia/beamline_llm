def cryoset(temper, waitseconds) '{
	cryoramp(360,temper)
	sleep(0.1)
	cryoramp(360,temper)
	sleep(0.1)
	cryoget()
	sleep(0.1)
	cryoramp(360,temper)
	sleep(waitseconds)
	p sprintf( "Temperature = %g", cryoget())
}'

def cryoset_autowait(temper) '{
	local _curtemp _waittime
	
	_curtemp=-1
	while( _curtemp<1) {
		_curtemp=cryoget()
		sleep(0.1)
	}
	if ( fabs(_curtemp-temper) > 0.2 ) {
		_waittime = int(fabs(_curtemp-temper)*12+1)
		p sprintf("setting temperature to T = %g  waittime = %g s", temper, _waittime)
		cryoset(temper, _waittime)
	}
	else {
		p sprintf("Already at temperature T = %g", _curtemp )
	}
}'

