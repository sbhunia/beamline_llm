	exit
}

h_ca = H
k_ca = K
l_ca = L

#counters ic2 pilroi
#plotselect pilroi

_METAFILE2="EUQAscan_" DATAFILE "_" SCAN_N+1 ".peak"

_STEPU=($2-$1)/$3

tseries 1 $4

for (_myE=$1;_myE<=$2;_myE=_myE+_STEPU){
moveE _myE
matchUE $5
ubr h_ca k_ca l_ca
fixana
sleep(5)
ct $4
