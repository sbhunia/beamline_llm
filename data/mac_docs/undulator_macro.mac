}

eval(sprintf("fclose %s", _METAFILE2))
'


def fixana '
getE
_mypol=(180.0/PI)*asin(4.0*LAMBDA/6.27091)
#6.70882 for HOPG 008, 6.27091 for Si 444
umv polth _mypol
'

def syncana '
getE
_mypol=(180.0/PI)*asin(4.0*LAMBDA/6.27091)
set polth _mypol
'





