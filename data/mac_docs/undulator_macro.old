## B(d)=c1*cos(2*pi*(d+c2)/(2*ulam_mm))
## EU(n,d)=(n*34.2/ulam_cm)/(1+(0.4362*ulam_cm*ulam_cm*B(d)*B(d))) 
## Need to calibrate c1 & c2 for each harmonic
## find "d" values that put the nth harmonic at known E's: this sets B(d) at these points.
## python routine to best-fit these points

## Testing version, Oct 23, JRuff

#global undB1, undoff1
#global undB3, undoff3
#global undB5, undoff5

global undB[]
global undoff[]


def new_calibU '
u mv undulator_calibration.data undulator_calibration.old
_UCALFILE="undulator_calibration.data"
on(_UCALFILE); p sprintf("## %s",date()); off(_UCALFILE)
'

def calibU_addpoint '
_harmonic=$1
_thisd=A[und_cl]
getE
_thisE=hc_over_e/LAMBDA
printf("Setting calibration point as %g mm, %g keV, Harm. #%g \n",_thisd,_thisE,_harmonic)
on(_UCALFILE); p sprintf("%g %g %g",_harmonic,_thisd,_thisE); off(_UCALFILE)

'

def calibU_fit '
_harmonic=$1
eval(sprintf("u python ~/Scripts/undulator_dBfit.py %s",_harmonic))

undB[_harmonic] = getval(" What is B? ", undB[_harmonic])
undoff[_harmonic] = getval(" What is the d offset? ", undoff[_harmonic])

'

def calcUE '
_harmonic=$1
_thisd=$2
_thisB=undB[_harmonic]*cos(PI*(_thisd+undoff[_harmonic])/(28.4))
_harmen=(_harmonic*(34.2/2.84))/(1.0+(0.4362*2.84*2.84*_thisB*_thisB))
printf("Harmonic #%g is at %g keV when und_cl=%g mm\n",_harmonic,_harmen,_thisd)
'

def calcUd '
_harmonic=$1
_thisE=$2
_thisB=0.533137*sqrt(((_harmonic*34.2)/(_thisE*2.84))-1.0)
_thisd=((28.4/PI)*acos(_thisB/undB[_harmonic]))-undoff[_harmonic]
printf("Harmonic #%g is at %g keV when und_cl=%g mm\n",_harmonic,_thisE,_thisd)
'

def wund '
getE
wm und_cl
print "..."
calcUE $1 A[und_cl]
'

def EU3scan '{
        local _i, _j, _d1, h_ca, k_ca, l_ca, _num

        if ($# != 4 && $# != 5 || $# == 5 && "$5" != "fixQ") {
                eprint "Usage: Escan start finish intervals time [fixQ]\n\
       (Units are KeV)\n\
       (the literal \"fixQ\" means keep HKL constant)"
                exit
        }

        { _s1 = $1; _f1 = $2; _num = int($3); _ctime = $4; }

        if (_s1 <= 0 || _f1 <= 0) {
                eprint "Can only deal with positive energies."
                exit
        }

        HEADING = sprintf("Escan %g %g %g %g%s",$1,$2,$3,$4,$#>4?" $5":"")
        _m[0] = Mono
        _nm = 1
        if (mono_type == 2) {
                _m[1] = mon_y
                _nm = 2
        }
        if (mono_type == 3 || mono_type == 4) {
                _m[1] = montrav
                _m[2] = mond
                _nm = 3
        }
        if (mono_type == 5) {
                _m[1] = monp
                _nm = 2
        }
        _m1 = _nm
        _d1 = (_f1 - _s1) / _num

        if ("$5" == "fixQ") {
                h_ca = H
                k_ca = K
                l_ca = L
                for (_i = 0; _i < _numgeo; _i++)
                        _m[_nm + _i] = mA[_i]
                _m1 += _numgeo
                _nm += _numgeo
        }

        _make_SCAN_POINTS("Escan", _num + 1, _nm + 1)

        for (_i = 0; _i <= _num; _i++) {
                local E

                E = _s1 + _i * _d1
                calcM E
                calcE
                E = hc_over_e / LAMBDA
		_thisB=0.533137*sqrt(((3.0*34.2)/(E*2.84))-1.0)
		A[und_cl]=((28.4/PI)*acos(_thisB/undB[3]))-undoff[3]

                if ("$5" == "fixQ") {
                        H = h_ca
                        K = k_ca
                        L = l_ca
                        calcA
                }
                for (_j = 0; _j < _nm; _j++)
                        SCAN_POINTS[_i][_j] = A[_m[_j]]
                SCAN_POINTS[_i][_j] = E
        }
        _stype = scanType_MotorScan|scanType_EnergyScan
        _array_scan
}'

def matchUE '
getE
calcUd $1 hc_over_e/LAMBDA
umv und_cl _thisd
'


def EU3Qscan '

if ($# != 4) {
	eprint "Usage:  EU3Qscan start finish intervals time"
	exit
}

h_ca = H
k_ca = K

l_ca = L

counters ic2 pilroi
plotselect pilroi

_METAFILE2="EU3Qscan_" DATAFILE "_" SCAN_N+1 ".peak"

_STEPU=($2-$1)/$3

tseries 1 $4

for (_myE=$1;_myE<=$2;_myE=_myE+_STEPU){
moveE _myE
matchUE 3
ubr h_ca k_ca l_ca
fixana
sleep(8)
ct $4
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,H,K,L,A[und_cl],S[cesr],S[ic1],S[ic2],S[pilroi]); off(_METAFILE2)
ct $4
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,H,K,L,A[und_cl],S[cesr],S[ic1],S[ic2],S[pilroi]); off(_METAFILE2)
ct $4
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,H,K,L,A[und_cl],S[cesr],S[ic1],S[ic2],S[pilroi]); off(_METAFILE2)
}

eval(sprintf("fclose %s", _METAFILE2))
'

def EU1Qscan '

if ($# != 4) {
	eprint "Usage:  EU3Qscan start finish intervals time"
	exit
}

wh

h_ca = H
k_ca = K
l_ca = L

counters ic2 pilroi
plotselect pilroi

_METAFILE2="EU3Qscan_" DATAFILE "_" SCAN_N+1 ".peak"

_STEPU=($2-$1)/$3

tseries 1 $4

for (_myE=$1;_myE<=$2;_myE=_myE+_STEPU){
moveE _myE
matchUE 1
ubr h_ca k_ca l_ca
#fixana
sleep(8)
ct $4
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,H,K,L,A[und_cl],S[cesr],S[ic1],S[ic2],S[pilroi],S[pilfluo]); off(_METAFILE2)
ct $4
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,H,K,L,A[und_cl],S[cesr],S[ic1],S[ic2],S[pilroi],S[pilfluo]); off(_METAFILE2)
ct $4
sleep(.1)
on(_METAFILE2); p sprintf("%5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f %5.4f ",_myE,H,K,L,A[und_cl],S[cesr],S[ic1],S[ic2],S[pilroi],S[pilfluo]); off(_METAFILE2)
}

eval(sprintf("fclose %s", _METAFILE2))
'

def fixana '
getE
_mypol=(180.0/PI)*asin(4.0*LAMBDA/6.27091)
#6.70882 for HOPG 008, 6.27091 for Si 444
umv polth _mypol
'

def syncana '
getE
_mypol=(180.0/PI)*asin(4.0*LAMBDA/6.27091)
set polth _mypol
'


