"""
adds meta data update for PIL10 for 4b
"""

global PILBEAMX
global PILBEAMY
global PILLAMBDA
global PILDIST

def pil10_meta '{
    #user define beam
    PILBEAMX = getval("X pixel of beam?",PILBEAMX)
    PILBEAMY = getval("Y pixel of beam?",PILBEAMY)

    #user define lambda
    if(LAMBDA != PILLAMBDA)
        p "SPEC calculates LAMBDA at " LAMBDA
    PILLAMBDA = getval("adjust LAMBDA?",LAMBDA)

    #user define distance
    PILDIST = getval("detector distance?",A[pil6my])
    if(PILDIST != A[pil6my])
        set pil6my PILDIST

    pil_im_set(0,"BeamX",PILBEAMX)
    pil_im_set(0,"BeamY",PILBEAMY)
    pil_im_set(0,"Wavelength",PILLAMBDA)
    pil_im_set(0,"DetDist",A[pil6my])
}'

def _pil10_meta '{
    for(i in PIL["det_on"]){
        #prompt user if dist has changed
        if(PILDIST != A[pil6my])
            pil10_meta

        #auto parameters    
        pil_im_set(0,"BeamX",PILBEAMX)
        pil_im_set(0,"BeamY",PILBEAMY)
        pil_im_set(0,"Wavelength",PILLAMBDA)
        pil_im_set(0,"DetDist",A[pil6my])
        pil_im_set(0,"Flux",1.0e12)
        pil_im_set(0,"Chi",A[chi])
        pil_im_set(0,"StartAngle",0)    #hardcoded to 0 atm
        pil_im_set(0,"Phi",A[phi])
        pil_im_set(0,"AngleIncr",_fly_pitch) # not sure yet
        pil_im_set(0,"PhiIncr",_fly_pitch)
        pil_im_set(0,"OscillAxis","Phi")        #hardcoded for phi
        pil_im_set(0,"NumOscill",_fly_intervals)
        p ">>>pil10 meta updated with PHI pitch " _fly_pitch

        #update globals
        #PILLAMBDA = LAMBDA
        #PILDIST = A[pil6my]
    }
}'

#macro toggles for embedding to flyscan
#def pil10_meta_on 'cdef("user_flyscan_pre_run","_pil10_meta;","_pil_",0x10)'
def pil10_meta_on 'cdef("user_prescan_head","_pil10_meta;","_pil_",0x10)'
def pil10_meta_off 'cdef("","", "_pil_", "delete")'
